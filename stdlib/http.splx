/// Universal HTTP client module backed by private JS FFI (`std/http`).

/// Outgoing HTTP request payload for `http.fetch(req)`.
pub type HttpRequest = struct {
    method: Str
    url: Str
    headers: Dict<Str, Str>
    body: Str?
}

/// Normalized HTTP response returned by `http.fetch`, `http.get`, and `http.post_json`.
pub type HttpResponse = struct {
    status: Int
    ok: Bool
    headers: Dict<Str, Str>
    body: Str
}

/// Executes an HTTP request using the host's `fetch` implementation.
pub extern async fn fetch(req: HttpRequest) -> Result<HttpResponse, Str> = "ffi_universal:httpFetch"

/// Sends an HTTP `GET` request to `url`.
pub fn get(url: Str) -> Result<HttpResponse, Str> {
    fetch({
        method: "GET",
        url: url,
        headers: dict_empty(),
        body: None
    })
}

/// Sends an HTTP `POST` request with JSON-serialized `payload` and `content-type: application/json`.
pub fn post_json(url: Str, payload: Json, headers: Dict<Str, Str> = dict_empty()) -> Result<HttpResponse, Str> {
    let hdrs = headers.set("content-type", "application/json")
    fetch({
        method: "POST",
        url: url,
        headers: hdrs,
        body: Some(json_stringify(payload))
    })
}

/// Server-only child process execution module (`std/proc`).
import os from "std/os"

/// Options for `proc.exec(cmd, args, opts)`.
pub type ExecOpts = struct {
    cwd: Str?
    timeout_ms: Int?
}

/// Captured exit status and output streams from a finished process.
pub type ExecOutput = struct {
    code: Int
    stdout: Str
    stderr: Str
}

/// Spawns `cmd` with `args` and `opts`, returning captured `{ code, stdout, stderr }`.
pub extern async fn exec(cmd: Str, args: Array<Str>, opts: ExecOpts) -> Result<ExecOutput, Str> = "ffi_server:procExec"

/// Executes a shell command string (`cmd /c` on Windows, `sh -c` on Unix).
pub fn shell(command: Str) -> Result<ExecOutput, Str> {
    let default_opts = { cwd: None, timeout_ms: None }
    if os.platform() == "win32" {
        exec("cmd", ["/c", command], default_opts)
    } else {
        exec("sh", ["-c", command], default_opts)
    }
}

/// Standard Library LLM & Agentic Execution Module (`std/llm`).
///
/// Built on a single minimal universal FFI facade (`ffi_llm:llmTurn`) supporting:
/// - `"openai_responses"` (OpenAI Responses API)
/// - `"openai_chat"` (OpenAI Chat Completions API)
/// - `"anthropic"` (Anthropic Messages API)
/// - `"google"` (Google Gemini `generateContent` / `streamGenerateContent`)
///
/// Exposes:
/// - `llm.ask<T>(...) @{ ... }`       — typed single-turn request returning `Result<T, Str>`
///   (auto-passes `type_schema<T>()` and decodes to `T`; returns plain `Str` when `T = Str`).
/// - `llm.ask_raw(...) @{ ... }`      — raw single-turn request returning `Result<LlmResponse, Str>`.
/// - `llm.agent<T>(...) @{ ... }`     — full multi-turn agentic loop with parameterized `AgentTool<Args, Out>`,
///   approval/modification `Decision` hooks, streaming deltas, auto-typed output `T`,
///   and ordered `traces.ExecutionTrace` (`events: Array<TraceEvent>`).
/// - `llm.agent_replay<T>(...)`       — deterministically replays an `ExecutionTrace` up to step `n`,
///   then continues running normally from that point onward.
/// - `llm.decide(...) @{ ... }`       — closed-set OpenAI & Google Decisions APIs.

import clock from "std/clock"
import traces, {
    UserPrompt,
    ThinkingStep,
    AssistantText,
    ToolCallStep,
    ToolDecisionStep,
    ToolResultStep,
    TurnCompleted,
    WarningStep
} from "std/traces"

// ============================================================================
// Types & ADTs
// ============================================================================

/// Multimodal attachment sent alongside a user prompt.
/// `kind`: `"image_base64"` | `"image_url"` | `"file_base64"` | `"text"`
pub type Attachment = struct {
    kind: Str
    mime_type: Str
    data: Str
    name: Str?
}

/// JSON-Schema tool definition sent to the LLM provider.
pub type ToolDef = struct {
    name: Str
    description: Str
    parameters: Json
}

/// A tool invocation requested by the LLM.
pub type ToolCall = struct {
    id: Str
    name: Str
    arguments: Json
}

/// Token accounting for a single LLM turn.
pub type TokenUsage = struct {
    input_tokens: Int
    output_tokens: Int
    total_tokens: Int
}

/// Incremental SSE streaming delta emitted during `stream: true` / `on_delta: Some(...)`.
pub enum StreamDelta {
    /// Assistant output text chunk
    TextDelta(Str)
    /// Model reasoning / chain-of-thought text chunk
    ThinkingDelta(Str)
    /// Model reasoning summary text chunk (e.g. OpenAI Responses `reasoning_summary_text.delta`)
    SummaryDelta(Str)
    /// Tool call argument chunk: `(tool_name, tool_call_id, args_delta)`
    ToolCallDelta(Str, Str, Str)
    /// End of streamed LLM turn
    DoneDelta
}

/// Single conversation message passed through the provider facade.
pub type Message = struct {
    role: Str
    content: Str
    attachments: Array<Attachment>
    tool_calls: Array<ToolCall>
    tool_call_id: Str?
    tool_name: Str?
}

/// Standard provider-agnostic reasoning/thinking level.
/// Translated natively per provider & model family (and safely dropped with a warning
/// on models that do not support thinking/reasoning parameters).
pub enum Thinking {
    ThinkOff
    ThinkLow
    ThinkMedium
    ThinkHigh
    ThinkMax
    ThinkBudget(Int)
}

/// Standard provider-agnostic tool selection policy.
pub enum ToolChoice {
    ToolAuto
    ToolRequired
    ToolNone
    ToolForce(Str)
}

/// Ordered output block emitted within a single LLM turn (preserving exact interleaving
/// of thinking, assistant text, and tool calls).
/// `kind`: `"thinking"` | `"text"` | `"tool_call"`
pub type ContentBlock = struct {
    kind: Str
    text: Str
    tool_call: ToolCall?
}

/// Normalized response from a single LLM turn across all four providers.
pub type LlmResponse = struct {
    text: Str
    thinking: Str?
    tool_calls: Array<ToolCall>
    blocks: Array<ContentBlock>
    finish_reason: Str
    usage: TokenUsage
    warnings: Array<Str>
    raw: Json
}

/// Decision returned by an approval/guardrail hook before executing a tool call.
pub enum Decision {
    Approve
    Reject(Str)
    Modify(Json)
}

/// Context passed into `on_decision` before each tool execution.
pub type DecisionRequest = struct {
    turn: Int
    tool_call: ToolCall
}

/// Type-erased executable tool accepted by `llm.agent(..., tools: [...])` when mixing
/// tools with different `<Args, Out>` signatures in the same array.
pub type AnyTool = struct {
    name: Str
    description: Str
    parameters: Json
    run_raw: async fn(Json) -> Result<Str, Str>
}

/// Strongly-typed, parameterized executable tool registered with `llm.agent(...)`.
/// Construct with `llm.tool<Args, Out>(name, description) { args -> ... }`:
/// - Automatically generates `parameters = type_schema<Args>()`
/// - Automatically validates & decodes raw JSON arguments into `Args`
/// - Returns plain `Str` when `Out = Str`, otherwise JSON-serializes `Out`
pub type AgentTool<Args, Out> = struct {
    name: Str
    description: Str
    parameters: Json
    run: async fn(Args) -> Result<Out, Str>
    run_raw: async fn(Json) -> Result<Str, Str>
}

/// Low-level request payload passed to the private FFI provider facade.
pub type TurnRequest = struct {
    provider: Str
    api_key: Str
    base_url: Str?
    model: Str
    system: Str?
    messages: Array<Message>
    max_tokens: Int?
    thinking: Thinking?
    thinking_effort: Str?
    temperature: Float?
    top_p: Float?
    stop: Array<Str>
    seed: Int?
    presence_penalty: Float?
    frequency_penalty: Float?
    tool_choice: ToolChoice?
    json_schema: Json?
    tools: Array<ToolDef>
    stream: Bool
    on_delta: (async fn(StreamDelta) -> Unit)?
}

/// Alias for `traces.ExecutionTrace` (ordered `events: Array<traces.TraceEvent>`).
pub type ExecutionTrace = traces.ExecutionTrace

// ============================================================================
// Decisions API Types (OpenAI `/v1/decisions` & Google `/v1beta/decisions`)
// ============================================================================

/// Question type for the OpenAI & Google Decisions APIs.
pub enum QuestionKind {
    /// Binary yes/no predicate (OpenAI `predicate`, Google `noul`) with optional true/false descriptions
    Predicate(Str?, Str?)
    /// Multiple choice: array of `(label, optional description)` pairs
    Choice(Array<(Str, Str?)>)
    /// Ordered rubric scale starting at 0: array of level descriptions
    Score(Array<Str>)
}

/// Single closed-set evaluation question submitted to `llm.decide(...)`.
pub type DecisionQuestion = struct {
    name: Str
    instructions: Str
    kind: QuestionKind
}

/// Typed answer returned by a Decisions API question.
pub enum DecisionValue {
    BoolAnswer(Bool)
    ChoiceAnswer(Str)
    ScoreAnswer(Float)
}

/// Calibrated statistical judgment for one question.
pub type DecisionAnswer = struct {
    name: Str
    kind: Str
    value: DecisionValue
    probability: Float
    probabilities: Dict<Str, Float>
    confidence: Float
    refusal: Str?
}

/// Low-level request passed to `ffi_llm:llmDecide`.
pub type DecisionsRequest = struct {
    provider: Str
    api_key: Str
    base_url: Str?
    model: Str
    input: Str
    attachments: Array<Attachment>
    questions: Array<DecisionQuestion>
    prompt_cache_key: Str?
}

/// Normalized response from OpenAI or Google Decisions API (zero output tokens).
pub type DecisionsResponse = struct {
    provider: Str
    model: Str
    answers: Dict<Str, DecisionAnswer>
    answer_list: Array<DecisionAnswer>
    usage: TokenUsage
    raw: Json
}

// ============================================================================
// Private JS FFI Facade Binding
// ============================================================================

/// Minimal private-FFI entry point talking to OpenAI Responses, OpenAI Chat,
/// Anthropic Messages, and Google Gemini APIs.
pub extern async fn raw_turn(req: TurnRequest) -> Result<LlmResponse, Str> = "ffi_llm:llmTurn"

/// Minimal private-FFI entry point talking to OpenAI `/v1/decisions` and
/// Google Gemini `/v1beta/decisions`.
pub extern async fn raw_decide(req: DecisionsRequest) -> Result<DecisionsResponse, Str> = "ffi_llm:llmDecide"

/// Private reified FFI helpers driving automatic `type_schema<T>()` + `decode<T>()`
/// for `llm.ask<T>`, `llm.agent<T>`, and `llm.tool<Args, Out>` (`AgentTool<Args, Out>`).
extern reified fn reified_output_schema<T>() -> Json? = "ffi_llm:reifiedOutputSchema"
extern reified fn reified_decode_output<T>(text: Str) -> Result<T, Str> = "ffi_llm:reifiedDecodeOutput"
extern reified fn reified_schema<T>() -> Json = "ffi_llm:reifiedSchema"
extern reified fn reified_decode_json<T>(raw: Json) -> Result<T, Str> = "ffi_llm:reifiedDecodeJson"
extern reified fn reified_encode_tool_output<T>(value: T) -> Str = "ffi_llm:reifiedEncodeToolOutput"

// ============================================================================
// Parameterized AgentTool Constructors (`llm.tool<Args, Out>` & `.any()`)
// ============================================================================

/// Creates a strongly-typed `AgentTool<Args, Out>`:
/// - Automatically derives `parameters` from `type_schema<Args>()`
/// - Automatically validates & decodes incoming JSON arguments into `Args`
/// - Encodes `Out` as plain `Str` when `Out = Str`, or JSON otherwise
/// Supports trailing lambda syntax: `llm.tool<Args, Out>(name: "...", description: "...") { args -> ... }`
pub reified fn tool<Args, Out>(
    name: Str,
    description: Str,
    run: async fn(Args) -> Result<Out, Str>
) -> AgentTool<Args, Out> {
    {
        name: name,
        description: description,
        parameters: reified_schema<Args>(),
        run: run,
        run_raw: { raw ->
            let args = reified_decode_json<Args>(raw)?
            let out = run(args)?
            Ok(reified_encode_tool_output<Out>(out))
        }
    }
}

/// Type-erases a parameterized `AgentTool<Args, Out>` into `AnyTool` so tools with
/// different `<Args, Out>` types can be combined in one `tools: [...]` array.
pub fn AgentTool<Args, Out>.any(self) -> AnyTool {
    {
        name: self.name,
        description: self.description,
        parameters: self.parameters,
        run_raw: self.run_raw
    }
}

/// Functional alias for `tool.any()`.
pub fn any_tool(
    t: {
        name: Str,
        description: Str,
        parameters: Json,
        run_raw: async fn(Json) -> Result<Str, Str>,
        ..
    }
) -> AnyTool {
    {
        name: t.name,
        description: t.description,
        parameters: t.parameters,
        run_raw: t.run_raw
    }
}

// ============================================================================
// Decisions API Helpers & `llm.decide(...)`
// ============================================================================

/// Builds a binary yes/no decision question (OpenAI `predicate`, Google `noul`).
pub fn predicate(
    name: Str,
    instructions: Str,
    true_description: Str? = None,
    false_description: Str? = None
) -> DecisionQuestion {
    {
        name: name,
        instructions: instructions,
        kind: Predicate(true_description, false_description)
    }
}

/// Builds a multiple-choice decision question from `(label, description?)` pairs.
pub fn choice(
    name: Str,
    instructions: Str,
    options: Array<(Str, Str?)>
) -> DecisionQuestion {
    {
        name: name,
        instructions: instructions,
        kind: Choice(options)
    }
}

/// Builds a rubric score decision question from ordered level descriptions (`0..N-1`).
pub fn score(
    name: Str,
    instructions: Str,
    levels: Array<Str>
) -> DecisionQuestion {
    {
        name: name,
        instructions: instructions,
        kind: Score(levels)
    }
}

/// Evaluates closed-set questions via OpenAI `/v1/decisions` (e.g. `gpt-6-luna`) or
/// Google Gemini `/v1beta/decisions` (e.g. `gemini-decision-1`), returning calibrated
/// probabilities and confidence scores. Accepts a trailing `@{ ... }` `Prompt` block.
pub fn decide(
    provider: Str,
    api_key: Str,
    model: Str,
    questions: Array<DecisionQuestion>,
    base_url: Str? = None,
    attachments: Array<Attachment> = [],
    prompt_cache_key: Str? = None,
    prompt: Prompt
) -> Result<DecisionsResponse, Str> {
    raw_decide({
        provider: provider,
        api_key: api_key,
        base_url: base_url,
        model: model,
        input: prompt.render(),
        attachments: attachments,
        questions: questions,
        prompt_cache_key: prompt_cache_key
    })
}

// ============================================================================
// Pure SPL High-Level API: `ask` (Single Turn) & `agent` (Full Agentic Flow)
// ============================================================================

/// Sends a raw single-turn request to any supported LLM provider and returns the
/// full `LlmResponse` (including `usage`, `thinking`, `warnings`, and `raw`).
/// Accepts a trailing `@{ ... }` `Prompt` block.
pub fn ask_raw(
    provider: Str,
    api_key: Str,
    model: Str,
    system: Str? = None,
    base_url: Str? = None,
    max_tokens: Int? = None,
    thinking: Thinking? = None,
    thinking_effort: Str? = None,
    temperature: Float? = None,
    top_p: Float? = None,
    stop: Array<Str> = [],
    seed: Int? = None,
    presence_penalty: Float? = None,
    frequency_penalty: Float? = None,
    tool_choice: ToolChoice? = None,
    json_schema: Json? = None,
    tools: Array<ToolDef> = [],
    attachments: Array<Attachment> = [],
    stream: Bool = false,
    on_delta: (async fn(StreamDelta) -> Unit)? = None,
    prompt: Prompt
) -> Result<LlmResponse, Str> {
    let user_msg: Message = {
        role: "user",
        content: prompt.render(),
        attachments: attachments,
        tool_calls: [],
        tool_call_id: None,
        tool_name: None
    }
    raw_turn({
        provider: provider,
        api_key: api_key,
        base_url: base_url,
        model: model,
        system: system,
        messages: [user_msg],
        max_tokens: max_tokens,
        thinking: thinking,
        thinking_effort: thinking_effort,
        temperature: temperature,
        top_p: top_p,
        stop: stop,
        seed: seed,
        presence_penalty: presence_penalty,
        frequency_penalty: frequency_penalty,
        tool_choice: tool_choice,
        json_schema: json_schema,
        tools: tools,
        stream: stream,
        on_delta: on_delta
    })
}

/// Sends a parameterized single-turn request `llm.ask<T>(...) @{ ... }` to any supported
/// LLM provider and returns `Result<T, Str>`:
/// - When `T` is `Str`, no JSON schema is sent and the plain text `Str` is returned.
/// - For any other type `T`, `type_schema<T>()` is automatically passed as `json_schema`
///   (unless explicitly overridden) and the response is decoded & validated into `T`.
pub reified fn ask<T>(
    provider: Str,
    api_key: Str,
    model: Str,
    system: Str? = None,
    base_url: Str? = None,
    max_tokens: Int? = None,
    thinking: Thinking? = None,
    thinking_effort: Str? = None,
    temperature: Float? = None,
    top_p: Float? = None,
    stop: Array<Str> = [],
    seed: Int? = None,
    presence_penalty: Float? = None,
    frequency_penalty: Float? = None,
    tool_choice: ToolChoice? = None,
    json_schema: Json? = None,
    tools: Array<ToolDef> = [],
    attachments: Array<Attachment> = [],
    stream: Bool = false,
    on_delta: (async fn(StreamDelta) -> Unit)? = None,
    prompt: Prompt
) -> Result<T, Str> {
    let eff_schema = match json_schema {
        Some(s) => Some(s)
        None => reified_output_schema<T>()
    }
    let resp = ask_raw(
        provider: provider,
        api_key: api_key,
        model: model,
        system: system,
        base_url: base_url,
        max_tokens: max_tokens,
        thinking: thinking,
        thinking_effort: thinking_effort,
        temperature: temperature,
        top_p: top_p,
        stop: stop,
        seed: seed,
        presence_penalty: presence_penalty,
        frequency_penalty: frequency_penalty,
        tool_choice: tool_choice,
        json_schema: eff_schema,
        tools: tools,
        attachments: attachments,
        stream: stream,
        on_delta: on_delta,
        prompt: prompt
    )?
    reified_decode_output<T>(resp.text)
}

// Internal helper: appends exact chronological model blocks + warnings from one LLM turn.
fn append_turn_response_events(
    events: Array<traces.TraceEvent>,
    turn: Int,
    resp: LlmResponse
) -> Array<traces.TraceEvent> {
    let mut out = events
    if resp.blocks.len() > 0 {
        let mut bi = 0
        while bi < resp.blocks.len() {
            match resp.blocks.get(bi) {
                Some(b) => {
                    if b.kind == "thinking" && b.text != "" {
                        out = out.push(ThinkingStep(turn, b.text))
                    } else if b.kind == "text" && b.text != "" {
                        out = out.push(AssistantText(turn, b.text))
                    } else if b.kind == "tool_call" {
                        match b.tool_call {
                            Some(tc) => {
                                out = out.push(ToolCallStep(turn, tc.id, tc.name, tc.arguments))
                            }
                            None => ()
                        }
                    }
                }
                None => ()
            }
            bi = bi + 1
        }
    } else {
        match resp.thinking {
            Some(th) if th != "" => { out = out.push(ThinkingStep(turn, th)) }
            _ => ()
        }
        if resp.text != "" {
            out = out.push(AssistantText(turn, resp.text))
        }
        let mut ti = 0
        while ti < resp.tool_calls.len() {
            match resp.tool_calls.get(ti) {
                Some(tc) => { out = out.push(ToolCallStep(turn, tc.id, tc.name, tc.arguments)) }
                None => ()
            }
            ti = ti + 1
        }
    }

    let mut wi = 0
    while wi < resp.warnings.len() {
        match resp.warnings.get(wi) {
            Some(w) => { out = out.push(WarningStep(turn, w)) }
            None => ()
        }
        wi = wi + 1
    }
    out
}

// Internal helper: evaluates `on_decision` and executes one tool call, returning
// `(decision_event, result_event, tool_message)`.
fn execute_single_tool_call(
    turn: Int,
    call: ToolCall,
    tools: Array<{
        name: Str,
        description: Str,
        parameters: Json,
        run_raw: async fn(Json) -> Result<Str, Str>,
        ..
    }>,
    on_decision: (async fn(DecisionRequest) -> Decision)?
) -> (traces.TraceEvent, traces.TraceEvent, Message) {
    let decision = match on_decision {
        Some(hook) => hook({ turn: turn, tool_call: call })
        None => Approve
    }

    let (dec_label, exec_args, rejected_msg) = match decision {
        Approve => ("approved", call.arguments, None)
        Modify(new_args) => ("modified", new_args, None)
        Reject(reason) => ("rejected:" + reason, call.arguments, Some(reason))
    }

    let (tool_output_str, succeeded) = match rejected_msg {
        Some(reason) => (json_stringify({ error: "Tool call rejected: " + reason }), false)
        None => {
            match tools.find({ t -> t.name == call.name }) {
                Some(tool) => {
                    match tool.run_raw(exec_args) {
                        Ok(out_str) => (out_str, true)
                        Err(err_msg) => (json_stringify({ error: err_msg }), false)
                    }
                }
                None => (json_stringify({ error: "Unknown tool: " + call.name }), false)
            }
        }
    }

    let dec_ev = ToolDecisionStep(turn, call.id, call.name, dec_label, exec_args)
    let res_ev = ToolResultStep(turn, call.id, call.name, tool_output_str, succeeded)
    let tool_msg: Message = {
        role: "tool",
        content: tool_output_str,
        attachments: [],
        tool_calls: [],
        tool_call_id: Some(call.id),
        tool_name: Some(call.name)
    }
    (dec_ev, res_ev, tool_msg)
}

// Internal shared live agent loop used by both `llm.agent<T>` and `llm.agent_replay<T>`.
reified fn agent_loop<T>(
    provider: Str,
    api_key: Str,
    model: Str,
    system: Str?,
    base_url: Str?,
    max_tokens: Int?,
    thinking: Thinking?,
    thinking_effort: Str?,
    temperature: Float?,
    top_p: Float?,
    stop: Array<Str>,
    seed: Int?,
    presence_penalty: Float?,
    frequency_penalty: Float?,
    tool_choice: ToolChoice?,
    eff_schema: Json?,
    tools: Array<{
        name: Str,
        description: Str,
        parameters: Json,
        run_raw: async fn(Json) -> Result<Str, Str>,
        ..
    }>,
    stream: Bool,
    on_delta: (async fn(StreamDelta) -> Unit)?,
    on_decision: (async fn(DecisionRequest) -> Decision)?,
    max_turns: Int,
    init_messages: Array<Message>,
    init_events: Array<traces.TraceEvent>,
    init_warnings: Array<Str>,
    init_in: Int,
    init_out: Int,
    init_turn: Int,
    run_start: Int
) -> Result<(T, traces.ExecutionTrace), Str> {
    let tool_defs: Array<ToolDef> = tools.map { t ->
        { name: t.name, description: t.description, parameters: t.parameters }
    }

    let mut messages = init_messages
    let mut events = init_events
    let mut all_warnings = init_warnings
    let mut total_in = init_in
    let mut total_out = init_out
    let mut turn = init_turn

    while turn < max_turns {
        turn = turn + 1
        let turn_start = clock.now_ms()

        let resp = raw_turn({
            provider: provider,
            api_key: api_key,
            base_url: base_url,
            model: model,
            system: system,
            messages: messages,
            max_tokens: max_tokens,
            thinking: thinking,
            thinking_effort: thinking_effort,
            temperature: temperature,
            top_p: top_p,
            stop: stop,
            seed: seed,
            presence_penalty: presence_penalty,
            frequency_penalty: frequency_penalty,
            tool_choice: tool_choice,
            json_schema: eff_schema,
            tools: tool_defs,
            stream: stream,
            on_delta: on_delta
        })?

        total_in = total_in + resp.usage.input_tokens
        total_out = total_out + resp.usage.output_tokens
        all_warnings = all_warnings.concat(resp.warnings)

        // Append ordered model output blocks (thinking, text, tool_call) & warnings
        events = append_turn_response_events(events, turn, resp)

        // No tool calls -> final answer reached!
        if resp.tool_calls.len() == 0 {
            let turn_dur = clock.now_ms() - turn_start
            events = events.push(TurnCompleted(
                turn,
                resp.usage.input_tokens,
                resp.usage.output_tokens,
                resp.usage.total_tokens,
                turn_dur,
                resp.finish_reason
            ))
            let trace: traces.ExecutionTrace = {
                provider: provider,
                model: model,
                turns: turn,
                events: events,
                total_input_tokens: total_in,
                total_output_tokens: total_out,
                total_duration_ms: clock.now_ms() - run_start,
                finish_reason: resp.finish_reason,
                warnings: all_warnings
            }
            let typed_val = reified_decode_output<T>(resp.text)?
            return Ok((typed_val, trace))
        }

        // Record assistant tool_call turn in conversation history
        let assistant_msg: Message = {
            role: "assistant",
            content: resp.text,
            attachments: [],
            tool_calls: resp.tool_calls,
            tool_call_id: None,
            tool_name: None
        }
        messages = messages.push(assistant_msg)

        let mut ci = 0
        while ci < resp.tool_calls.len() {
            match resp.tool_calls.get(ci) {
                Some(call) => {
                    let (dec_ev, res_ev, tool_msg) = execute_single_tool_call(turn, call, tools, on_decision)
                    events = events.push(dec_ev)
                    events = events.push(res_ev)
                    messages = messages.push(tool_msg)
                }
                None => ()
            }
            ci = ci + 1
        }

        let turn_dur = clock.now_ms() - turn_start
        events = events.push(TurnCompleted(
            turn,
            resp.usage.input_tokens,
            resp.usage.output_tokens,
            resp.usage.total_tokens,
            turn_dur,
            resp.finish_reason
        ))
    }

    Err("Agent exceeded max_turns (" + to_str(max_turns) + ") without producing a final response")
}

/// Runs a parameterized full multi-turn agentic loop `llm.agent<T>(...) @{ ... }` with tool calls,
/// `Decision` approval/modification hooks, attachments, streaming deltas, and standard params:
/// - When `T` is `Str`, returns `Ok((text, execution_trace))` without enforcing JSON Schema.
/// - For any other type `T`, automatically passes `type_schema<T>()` and decodes the final
///   response into `T`, returning `Ok((typed_value, execution_trace))`.
/// - `execution_trace.events` is an ordered, alternated `Array<traces.TraceEvent>` capturing the
///   exact chronological sequence of prompts, thinking, text, tool calls, decisions & tool results.
pub reified fn agent<T>(
    provider: Str,
    api_key: Str,
    model: Str,
    system: Str? = None,
    base_url: Str? = None,
    max_tokens: Int? = None,
    thinking: Thinking? = None,
    thinking_effort: Str? = None,
    temperature: Float? = None,
    top_p: Float? = None,
    stop: Array<Str> = [],
    seed: Int? = None,
    presence_penalty: Float? = None,
    frequency_penalty: Float? = None,
    tool_choice: ToolChoice? = None,
    json_schema: Json? = None,
    tools: Array<{
        name: Str,
        description: Str,
        parameters: Json,
        run_raw: async fn(Json) -> Result<Str, Str>,
        ..
    }> = [],
    attachments: Array<Attachment> = [],
    stream: Bool = false,
    on_delta: (async fn(StreamDelta) -> Unit)? = None,
    on_decision: (async fn(DecisionRequest) -> Decision)? = None,
    max_turns: Int = 10,
    prompt: Prompt
) -> Result<(T, traces.ExecutionTrace), Str> {
    let run_start = clock.now_ms()
    let eff_schema = match json_schema {
        Some(s) => Some(s)
        None => reified_output_schema<T>()
    }
    let prompt_text = prompt.render()
    let initial_msg: Message = {
        role: "user",
        content: prompt_text,
        attachments: attachments,
        tool_calls: [],
        tool_call_id: None,
        tool_name: None
    }
    agent_loop<T>(
        provider, api_key, model, system, base_url, max_tokens,
        thinking, thinking_effort, temperature, top_p, stop, seed,
        presence_penalty, frequency_penalty, tool_choice, eff_schema,
        tools, stream, on_delta, on_decision, max_turns,
        [initial_msg], [UserPrompt(prompt_text)], [], 0, 0, 0, run_start
    )
}

/// Deterministically replays the first `up_to_step` events (`trace.events[0..up_to_step]`)
/// without making LLM calls or re-executing already-recorded tool calls, then resumes
/// normal live execution from that exact state onward:
/// - `up_to_step == 0`: runs live from the start.
/// - `up_to_step` mid-turn (after `ToolCallStep`s): skips the model call and executes only
///   any unexecuted pending tool calls live, then continues to subsequent turns live.
/// - `up_to_step` at a turn boundary: skips all completed turns and resumes live at the next turn.
/// - `up_to_step >= trace.events.len()` (after final turn): returns decoded `T` with zero live calls.
pub reified fn agent_replay<T>(
    trace: traces.ExecutionTrace,
    up_to_step: Int,
    provider: Str,
    api_key: Str,
    model: Str,
    system: Str? = None,
    base_url: Str? = None,
    max_tokens: Int? = None,
    thinking: Thinking? = None,
    thinking_effort: Str? = None,
    temperature: Float? = None,
    top_p: Float? = None,
    stop: Array<Str> = [],
    seed: Int? = None,
    presence_penalty: Float? = None,
    frequency_penalty: Float? = None,
    tool_choice: ToolChoice? = None,
    json_schema: Json? = None,
    tools: Array<{
        name: Str,
        description: Str,
        parameters: Json,
        run_raw: async fn(Json) -> Result<Str, Str>,
        ..
    }> = [],
    attachments: Array<Attachment> = [],
    stream: Bool = false,
    on_delta: (async fn(StreamDelta) -> Unit)? = None,
    on_decision: (async fn(DecisionRequest) -> Decision)? = None,
    max_turns: Int = 10,
    prompt: Prompt? = None
) -> Result<(T, traces.ExecutionTrace), Str> {
    let run_start = clock.now_ms()
    let eff_schema = match json_schema {
        Some(s) => Some(s)
        None => reified_output_schema<T>()
    }

    let total_avail = trace.events.len()
    let limit = if up_to_step < 0 {
        0
    } else if up_to_step > total_avail {
        total_avail
    } else {
        up_to_step
    }

    let mut messages: Array<Message> = []
    let mut events: Array<traces.TraceEvent> = []
    let mut all_warnings: Array<Str> = []
    let mut total_in = 0
    let mut total_out = 0
    let mut current_turn = 0
    let mut last_finish_reason = "stop"

    let mut turn_text = ""
    let mut turn_calls: Array<ToolCall> = []
    let mut completed_call_ids: Array<Str> = []
    let mut assistant_flushed = false
    let mut final_answer_reached = false
    let mut final_answer_text = ""

    let mut i = 0
    while i < limit {
        match trace.events.get(i) {
            Some(ev) => {
                events = events.push(ev)
                match ev {
                    UserPrompt(content) => {
                        let u_msg: Message = {
                            role: "user",
                            content: content,
                            attachments: attachments,
                            tool_calls: [],
                            tool_call_id: None,
                            tool_name: None
                        }
                        messages = messages.push(u_msg)
                    }
                    ThinkingStep(t, _) => {
                        if t > current_turn {
                            current_turn = t
                            turn_text = ""
                            turn_calls = []
                            completed_call_ids = []
                            assistant_flushed = false
                        }
                    }
                    AssistantText(t, txt) => {
                        if t > current_turn {
                            current_turn = t
                            turn_text = ""
                            turn_calls = []
                            completed_call_ids = []
                            assistant_flushed = false
                        }
                        turn_text = turn_text + txt
                    }
                    ToolCallStep(t, id, name, arguments) => {
                        if t > current_turn {
                            current_turn = t
                            turn_text = ""
                            turn_calls = []
                            completed_call_ids = []
                            assistant_flushed = false
                        }
                        let tc: ToolCall = { id: id, name: name, arguments: arguments }
                        turn_calls = turn_calls.push(tc)
                    }
                    ToolDecisionStep(_, _, _, _, _) => ()
                    ToolResultStep(_, id, name, out_str, _) => {
                        if !assistant_flushed {
                            let a_msg: Message = {
                                role: "assistant",
                                content: turn_text,
                                attachments: [],
                                tool_calls: turn_calls,
                                tool_call_id: None,
                                tool_name: None
                            }
                            messages = messages.push(a_msg)
                            assistant_flushed = true
                        }
                        completed_call_ids = completed_call_ids.push(id)
                        let t_msg: Message = {
                            role: "tool",
                            content: out_str,
                            attachments: [],
                            tool_calls: [],
                            tool_call_id: Some(id),
                            tool_name: Some(name)
                        }
                        messages = messages.push(t_msg)
                    }
                    TurnCompleted(t, inp, out, _, _, fin) => {
                        if t > current_turn { current_turn = t }
                        total_in = total_in + inp
                        total_out = total_out + out
                        last_finish_reason = fin
                        if turn_calls.len() == 0 {
                            final_answer_reached = true
                            final_answer_text = turn_text
                        }
                        turn_text = ""
                        turn_calls = []
                        completed_call_ids = []
                        assistant_flushed = false
                    }
                    WarningStep(_, msg) => {
                        all_warnings = all_warnings.push(msg)
                    }
                }
            }
            None => ()
        }
        i = i + 1
    }

    // Case 1: Full replay already reached a completed final answer (zero live calls!)
    if final_answer_reached {
        let replayed_trace: traces.ExecutionTrace = {
            provider: provider,
            model: model,
            turns: current_turn,
            events: events,
            total_input_tokens: total_in,
            total_output_tokens: total_out,
            total_duration_ms: clock.now_ms() - run_start,
            finish_reason: last_finish_reason,
            warnings: all_warnings
        }
        let typed_val = reified_decode_output<T>(final_answer_text)?
        return Ok((typed_val, replayed_trace))
    }

    // Case 2: Stopped mid-turn after ToolCallStep(s) — execute remaining pending tools live!
    if turn_calls.len() > 0 {
        if !assistant_flushed {
            let a_msg: Message = {
                role: "assistant",
                content: turn_text,
                attachments: [],
                tool_calls: turn_calls,
                tool_call_id: None,
                tool_name: None
            }
            messages = messages.push(a_msg)
            assistant_flushed = true
        }
        let mut ci = 0
        while ci < turn_calls.len() {
            match turn_calls.get(ci) {
                Some(call) => {
                    let already_done = match completed_call_ids.find({ cid -> cid == call.id }) {
                        Some(_) => true
                        None => false
                    }
                    if !already_done {
                        let (dec_ev, res_ev, tool_msg) = execute_single_tool_call(current_turn, call, tools, on_decision)
                        events = events.push(dec_ev)
                        events = events.push(res_ev)
                        messages = messages.push(tool_msg)
                    }
                }
                None => ()
            }
            ci = ci + 1
        }
        events = events.push(TurnCompleted(current_turn, 0, 0, 0, 0, "tool_calls"))
    }

    // Case 3: No UserPrompt was replayed (e.g. up_to_step == 0) — seed from explicit prompt or trace's first UserPrompt
    if messages.len() == 0 {
        let mut seed_prompt = match prompt {
            Some(p) => p.render()
            None => ""
        }
        if seed_prompt == "" {
            let mut si = 0
            while si < trace.events.len() {
                match trace.events.get(si) {
                    Some(UserPrompt(c)) => {
                        seed_prompt = c
                        si = trace.events.len()
                    }
                    _ => { si = si + 1 }
                }
            }
        }
        let u_msg: Message = {
            role: "user",
            content: seed_prompt,
            attachments: attachments,
            tool_calls: [],
            tool_call_id: None,
            tool_name: None
        }
        messages = messages.push(u_msg)
        events = events.push(UserPrompt(seed_prompt))
    }

    // Resume normal live agent execution from the reconstructed state
    agent_loop<T>(
        provider, api_key, model, system, base_url, max_tokens,
        thinking, thinking_effort, temperature, top_p, stop, seed,
        presence_penalty, frequency_penalty, tool_choice, eff_schema,
        tools, stream, on_delta, on_decision, max_turns,
        messages, events, all_warnings, total_in, total_out, current_turn, run_start
    )
}

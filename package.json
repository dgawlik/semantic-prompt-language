{
  "name": "spl-lang",
  "version": "4.1.1",
  "description": "Semantic Prompt Language (SPL) — Agent-first strongly-typed functional language compiled to ESM JavaScript",
  "type": "module",
  "bin": {
    "spl": "./dist/cli.js",
    "spl-lsp": "./dist/lsp.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./runtime/core": "./runtime/core.mjs",
    "./runtime/ffi_universal": "./runtime/ffi_universal.mjs",
    "./runtime/ffi_server": "./runtime/ffi_server.mjs",
    "./runtime/ffi_codegen": "./runtime/ffi_codegen.mjs",
    "./runtime/ffi_llm": "./runtime/ffi_llm.mjs",
    "./runtime/llm_capabilities": "./runtime/llm_capabilities.mjs"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test tests/*.test.mjs",
    "spl": "node dist/cli.js",
    "vscode:install": "node scripts/install-vscode.mjs",
    "vscode:uninstall": "node scripts/install-vscode.mjs --uninstall",
    "vscode:package": "node scripts/package-vscode.mjs",
    "vscode:package:install": "node scripts/package-vscode.mjs --install",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

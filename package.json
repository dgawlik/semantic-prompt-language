{
  "name": "spl-lang-v5",
  "version": "5.0.0",
  "description": "Semantic Prompt Language (SPL) v5 reference compiler, canonical bytecode VM, and OpenAI SDK runtime",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "spl": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "spl": "node dist/src/cli.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc --noEmit",
    "install:vscode": "node vscode-spl/install.mjs",
    "uninstall:vscode": "node vscode-spl/install.mjs --uninstall"
  },
  "dependencies": {
    "openai": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}

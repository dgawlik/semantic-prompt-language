# SYNTAX TEST "source.spl" "generation, agents, raw tools, guidance and restrictions"

    @{model='gpt-5'}
#   ^ keyword.other.directive.spl
#     ^^^^^ variable.parameter.directive.spl
    let a = ?'hello'
#           ^ keyword.operator.llm.spl
#            ^^^^^^^ string.quoted.single.spl
    let b = ?{len='sentence', fmt='json'} 'joke'
#           ^ keyword.operator.llm.spl
#             ^^^ variable.parameter.modifier.spl
#                             ^^^ variable.parameter.modifier.spl
    think{reasoning='low'} 'why'
#   ^^^^^ keyword.other.think.spl
#         ^^^^^^^^^ variable.parameter.modifier.spl
    think{show=True} 'why'
#         ^^^^ variable.parameter.modifier.spl
#              ^^^^ constant.language.spl
    agent{schema=Contract, repairs=0} 'work'
#   ^^^^^ keyword.other.agent.spl
#         ^^^^^^ variable.parameter.modifier.spl
    agent 'work'
#   ^^^^^ keyword.other.agent.spl
    let r = read_file('./a.txt')
#           ^^^^^^^^^ support.function.tool.spl
    write_file('./o', text)
#   ^^^^^^^^^^ support.function.tool.spl
    shell('git status')
#   ^^^^^ support.function.tool.spl
    web_fetch('https://a.com')
#   ^^^^^^^^^ support.function.tool.spl
    instruct 'be nice' { pass }
#   ^^^^^^^^ keyword.control.constraint.spl
    avoid 'rude' { pass }
#   ^^^^^ keyword.control.constraint.spl
    restrict './out' { pass }
#   ^^^^^^^^ keyword.control.restrict.spl
    restrict net 'a.com' { pass }
#            ^^^ storage.modifier.restrict-kind.spl
    restrict exec 'git' { pass }
#            ^^^^ storage.modifier.restrict-kind.spl
    content = 5

{
  "name": "spl-lang-vscode",
  "displayName": "SPL - Semantic Prompt Language",
  "description": "Language support for .spl workflows: natural-language instructions for models and agents, interleaved with TypeScript",
  "version": "3.4.0",
  "publisher": "spl-lang",
  "icon": "icon.png",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/dgawlik/semantic-prompt-language.git",
    "directory": "vscode"
  },
  "private": true,
  "engines": {
    "vscode": "^1.82.0"
  },
  "main": "./out/extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Workflow editing is available; running workflows requires workspace trust."
    },
    "virtualWorkspaces": { "supported": false }
  },
  "activationEvents": [
    "onLanguage:spl"
  ],
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "spl",
    "llm",
    "prompt",
    "agents",
    "typescript"
  ],
  "contributes": {
    "languages": [
      {
        "id": "spl",
        "aliases": ["SPL", "Semantic Prompt Language", "spl"],
        "extensions": [".spl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "spl",
        "scopeName": "source.spl",
        "path": "./syntaxes/spl.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.markdown": "markdown"
        }
      }
    ],
    "snippets": [
      {
        "language": "spl",
        "path": "./snippets/spl.code-snippets"
      }
    ],
    "commands": [
      { "command": "spl.run", "title": "SPL: Run Workflow", "icon": "$(play)", "enablement": "isWorkspaceTrusted" },
      { "command": "spl.debug", "title": "SPL: Debug Workflow", "icon": "$(debug-alt)", "enablement": "isWorkspaceTrusted" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "spl.run", "when": "editorLangId == spl" },
        { "command": "spl.debug", "when": "editorLangId == spl" }
      ],
      "editor/title/run": [
        { "command": "spl.run", "when": "resourceLangId == spl", "group": "navigation@1" },
        { "command": "spl.debug", "when": "resourceLangId == spl", "group": "navigation@2" }
      ],
      "editor/context": [
        { "command": "spl.run", "when": "resourceLangId == spl", "group": "spl@1" },
        { "command": "spl.debug", "when": "resourceLangId == spl", "group": "spl@2" }
      ],
      "explorer/context": [
        { "command": "spl.run", "when": "resourceLangId == spl", "group": "spl@1" },
        { "command": "spl.debug", "when": "resourceLangId == spl", "group": "spl@2" }
      ]
    },
    "configuration": {
      "title": "SPL",
      "properties": {
        "spl.executablePath": {
          "type": "string",
          "default": "spl",
          "scope": "machine",
          "description": "The spl executable that Run Workflow and Debug Workflow start in the terminal: a name on the PATH, a full path, or a command such as `npx spl`."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run typecheck && npm run build",
    "test": "npm run typecheck && node build.mjs --test && node --test \"out/test/*.test.cjs\"",
    "package": "vsce package --skip-license"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.82.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.0.0"
  }
}

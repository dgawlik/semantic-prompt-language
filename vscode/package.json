{
  "name": "spl-lang-vscode",
  "displayName": "SPL - Semantic Prompt Language",
  "description": "Executable Markdown with SPL blocks and natural-language workflows",
  "version": "1.0.0",
  "publisher": "spl-lang",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/dgawlik/semantic-prompt-language.git",
    "directory": "vscode"
  },
  "private": true,
  "engines": {
    "vscode": "^1.82.0"
  },
  "main": "./out/extension.cjs",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "spl",
    "llm",
    "prompt",
    "copilot"
  ],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "languages": [
      {
        "id": "spl",
        "aliases": [
          "SPL",
          "Semantic Prompt Language"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "spl",
        "scopeName": "source.spl",
        "path": "./syntaxes/spl.tmLanguage.json"
      },
      {
        "scopeName": "spl.markdown.injection",
        "path": "./syntaxes/markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.spl": "spl"
        }
      }
    ],
    "snippets": [
      {
        "language": "spl",
        "path": "./snippets/spl.code-snippets"
      },
      {
        "language": "markdown",
        "path": "./snippets/markdown.code-snippets"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run typecheck && npm run build",
    "test": "npm run typecheck && node build.mjs --test && node --test out/test/language-server.test.cjs && node test/run-assertions.mjs && node test/check-examples.mjs",
    "package": "vsce package --skip-license"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.82.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.0.0"
  }
}

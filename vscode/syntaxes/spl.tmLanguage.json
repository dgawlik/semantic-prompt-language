{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SPL",
  "scopeName": "source.spl",
  "patterns": [
    { "include": "source.ts" }
  ],
  "injections": {
    "L:source.spl - string - comment - meta.block.spl - meta.embedded.block.markdown": {
      "patterns": [
        { "include": "#markdown-comment" },
        { "include": "#block" }
      ]
    }
  },
  "repository": {
    "markdown-comment": {
      "patterns": [
        {
          "name": "meta.documentation.spl",
          "begin": "^\\s*(//\\*)(?=\\s|$)",
          "beginCaptures": { "1": { "name": "comment.block.documentation.spl punctuation.definition.comment.begin.spl" } },
          "while": "^(?!\\s*\\*//)",
          "contentName": "meta.embedded.block.markdown",
          "patterns": [
            { "include": "text.html.markdown" }
          ]
        },
        {
          "match": "^\\s*(\\*//)",
          "captures": { "1": { "name": "comment.block.documentation.spl punctuation.definition.comment.end.spl" } }
        }
      ]
    },
    "block": {
      "name": "meta.block.spl",
      "begin": "^\\s*(---)\\s*$",
      "beginCaptures": { "1": { "name": "keyword.control.block.begin.spl" } },
      "end": "^\\s*(---)\\s*$",
      "endCaptures": { "1": { "name": "keyword.control.block.end.spl" } },
      "patterns": [
        { "include": "#output-type" },
        { "include": "#header" },
        { "include": "#instruction" }
      ]
    },
    "output-type": {
      "match": "^\\s*(outputType)\\s*(:)(?=\\s|$)[ \\t]*(.*)$",
      "captures": {
        "1": { "name": "entity.name.tag.header.spl" },
        "2": { "name": "punctuation.separator.key-value.spl" },
        "3": { "name": "meta.embedded.inline.typescript", "patterns": [{ "include": "source.ts" }] }
      }
    },
    "header": {
      "name": "meta.header.spl",
      "begin": "^(\\s*)(mode|model|reasoning|enforce|forbid|hide|tokens|restrict|outputVar|repairs|seed|temperature|topP)\\s*(:)(?=\\s|$)",
      "beginCaptures": {
        "2": { "name": "entity.name.tag.header.spl" },
        "3": { "name": "punctuation.separator.key-value.spl" }
      },
      "while": "^(?!\\s*---\\s*$)(?=\\1\\s+\\S)",
      "patterns": [
        { "include": "source.yaml" }
      ]
    },
    "instruction": {
      "begin": "^(?!\\s*---\\s*$)(\\s*[A-Za-z]+$)?",
      "beginCaptures": { "1": { "name": "meta.embedded.inline.header.spl" } },
      "while": "^(?!\\s*---\\s*$)",
      "contentName": "string.unquoted.instruction.spl",
      "patterns": [
        { "match": "@@", "name": "constant.character.escape.spl" },
        { "include": "#generated-function" },
        { "include": "#output" },
        { "include": "#reference" }
      ]
    },
    "generated-function": {
      "match": "(->)[ \\t]*(@)([A-Za-z_$][\\w$]*)(\\(.*)",
      "name": "meta.embedded.inline.output.spl",
      "captures": {
        "1": { "name": "keyword.operator.arrow.spl" },
        "2": { "name": "punctuation.definition.variable.spl" },
        "3": { "name": "entity.name.function.spl" },
        "4": {
          "name": "meta.embedded.inline.typescript",
          "patterns": [
            { "include": "source.ts#function-parameters" },
            { "include": "source.ts#return-type" }
          ]
        }
      }
    },
    "output": {
      "match": "(->)[ \\t]*(?:(\\[)((?:[^\\[\\]]|(\\[(?:[^\\[\\]]|\\g<4>)*\\]))*)(\\])[ \\t]*)?(@)(=)?([A-Za-z_$][\\w$]*)",
      "name": "meta.embedded.inline.output.spl",
      "captures": {
        "1": { "name": "keyword.operator.arrow.spl" },
        "2": { "name": "punctuation.section.brackets.begin.spl" },
        "3": { "name": "meta.embedded.inline.typescript", "patterns": [{ "include": "source.ts" }] },
        "5": { "name": "punctuation.section.brackets.end.spl" },
        "6": { "name": "punctuation.definition.variable.spl" },
        "7": { "name": "keyword.operator.assignment.spl" },
        "8": { "name": "variable.other.constant.output.spl" }
      }
    },
    "reference": {
      "match": "(?<![\\w@])(@)[A-Za-z_$][\\w$]*(?:\\.[A-Za-z_$][\\w$]*)*",
      "name": "meta.embedded.inline.reference.spl variable.other.reference.spl",
      "captures": {
        "1": { "name": "punctuation.definition.variable.spl" }
      }
    }
  }
}

{
  "scopeName": "spl.markdown.injection",
  "injectionSelector": "L:text.html.markdown -comment -markup.fenced_code.block",
  "patterns": [
    {
      "begin": "^ {0,3}(`{3,})spl\\s*$",
      "end": "^ {0,3}\\1`*\\s*$",
      "name": "markup.fenced_code.block.spl",
      "contentName": "meta.embedded.block.spl",
      "patterns": [{ "include": "source.spl" }]
    },
    {
      "begin": "^ {0,3}(~{3,})spl\\s*$",
      "end": "^ {0,3}\\1~*\\s*$",
      "name": "markup.fenced_code.block.spl",
      "contentName": "meta.embedded.block.spl",
      "patterns": [{ "include": "source.spl" }]
    },
    {
      "begin": "^ {0,3}>\\s?",
      "end": "$",
      "name": "markup.quote.spl",
      "contentName": "string.unquoted.blockquote.spl",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.quote.begin.spl" }
      },
      "patterns": [
        {
          "match": "(?<![\\w@])@[A-Za-z_]\\w*",
          "name": "meta.embedded.inline.spl variable.other.reference.spl"
        }
      ]
    }
  ]
}

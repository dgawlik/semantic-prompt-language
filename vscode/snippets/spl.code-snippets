{
  "Ask block": {
    "prefix": "ask",
    "body": [
      "---",
      "outputVar: ${1:answer}",
      "outputType: ${2:Str}",
      "",
      "${0:Instruction with @references}",
      "---"
    ],
    "description": "One model call whose answer is coerced to a type and declared as a constant"
  },
  "Agent block": {
    "prefix": "agent",
    "body": [
      "---",
      "mode: agent",
      "",
      "${1:Instruction with @references} ->[${2:Str}] @${3:result}",
      "---",
      "$0"
    ],
    "description": "An agent that acts with tools, reads @references and saves its outputs"
  },
  "Codegen block": {
    "prefix": "codegen",
    "body": [
      "---",
      "mode: codegen",
      "",
      "${1:What the function does} -> @${2:name}(${3:value: string}): ${4:string}",
      "---",
      "$0"
    ],
    "description": "A function generated by the model and cached beside the workflow"
  },
  "Decision": {
    "prefix": "decision",
    "body": [
      "if (await decision({ evidence: [${1:evidence}], question: '${2:Is it true?}', cutoff: ${3:0.8} })) {",
      "\t$0",
      "}"
    ],
    "description": "Branch on a yes/no decision: true when the probability of yes exceeds the cutoff"
  },
  "Decision with labels": {
    "prefix": "decision-labels",
    "body": [
      "if (await decision({ evidence: [${1:evidence}], question: '${2:Which one?}', labels: { ${3:yes}: true, ${4:no}: false } })) {",
      "\t$0",
      "}"
    ],
    "description": "Branch on a choice of labels, each standing for true or false"
  },
  "File defaults": {
    "prefix": "defaults",
    "body": [
      "---",
      "model: ${1:model-name}",
      "---",
      "$0"
    ],
    "description": "Defaults for every block of the file; must come before any code or block"
  },
  "Markdown comment": {
    "prefix": "doc",
    "body": [
      "//*",
      "${0:# Title}",
      "*//"
    ],
    "description": "Prose in Markdown, rendered by `spl doc`; top level only"
  },
  "Custom tool": {
    "prefix": "tool",
    "body": [
      "const ${1:lookup} = defineTool({",
      "\tname: '${1:lookup}',",
      "\tdescription: '${2:Describe what the tool does}',",
      "\tinput: Struct('${3:LookupInput}', {",
      "\t\t${4:query}: Str.describe('${5:Input parameter}'),",
      "\t}),",
      "\texecute: ({ ${4:query} }) => {",
      "\t\t$0",
      "\t},",
      "});"
    ],
    "description": "Define a typed custom tool for agent(..., { tools })"
  },
  "Attachment": {
    "prefix": "attach",
    "body": [
      "attach('${1:./file.pdf}')"
    ],
    "description": "Create a multimodal attachment (image, PDF or file) for ask() or agent()"
  }
}

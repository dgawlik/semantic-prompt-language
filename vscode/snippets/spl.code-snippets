{
  "Function": {
    "prefix": "def",
    "body": ["def ${1:name}(${2:args}):", "    ${0:pass}"],
    "description": "Function definition"
  },
  "If": {
    "prefix": "if",
    "body": ["if ${1:condition}:", "    ${0:pass}"],
    "description": "if block"
  },
  "If / else": {
    "prefix": "ifelse",
    "body": ["if ${1:condition}:", "    ${2:pass}", "else:", "    ${0:pass}"],
    "description": "if / else block"
  },
  "For loop": {
    "prefix": "for",
    "body": ["for ${1:item} in ${2:items}:", "    ${0:pass}"],
    "description": "for loop"
  },
  "If expression": {
    "prefix": "ifexpr",
    "body": ["let ${1:result} = if ${2:condition}:", "    ${3:value}", "else:", "    ${0:other}"],
    "description": "Conditional expression returning the selected branch's final expression"
  },
  "Leveled log": {
    "prefix": "loglevel",
    "body": ["log(level=${1|debug,info,error|})(${0:value})"],
    "description": "Write a script log at the selected severity"
  },
  "While loop": {
    "prefix": "while",
    "body": ["while ${1:condition}:", "    ${0:pass}"],
    "description": "while loop"
  },
  "Variable": {
    "prefix": "let",
    "body": ["let ${1:name} = ${0:value}"],
    "description": "Variable declaration"
  },
  "LLM call": {
    "prefix": "ask",
    "body": ["let ${1:answer} = ask(len='${2|word,sentence,paragraph,long|}') '${0:prompt}'"],
    "description": "LLM call with a length hint"
  },
  "LLM call (object)": {
    "prefix": "askobj",
    "body": ["let ${1:result} = ask(fmt='object') '''", "${2:prompt}", "", "Reply as JSON: {{\"${3:key}\": ${4:str}}}'''"],
    "description": "LLM call whose JSON response is validated and parsed"
  },
  "Think": {
    "prefix": "think",
    "body": ["let ${1:answer} = think(", "    reasoning = '${2|low,medium,high|}',", "    show = ${3|False,True|},", ") '${0:problem}'"],
    "description": "Generation-only reasoning"
  },
  "Human input": {
    "prefix": "human",
    "body": ["let ${1:answer} = human '${0:question}'"],
    "description": "Pause a checkpoint run for noninteractive free-text input"
  },
  "Try / except": {
    "prefix": "try",
    "body": ["try:", "    ${1:pass}", "except ${2:err}:", "    ${0:pass}"],
    "description": "Catch failures"
  },
  "Validated generation": {
    "prefix": ["askschema", "retry"],
    "body": ["let ${1:result} = ask(", "    schema = ${2:Contract},", "    reasoning = '${3|low,medium,high|}',", "    repairs = ${4:2},", ") '${0:prompt}'"],
    "description": "Validate JSON and repair generation only, without repeating external actions"
  },
  "Agent": {
    "prefix": "agent",
    "body": ["let ${1:result} = agent(reasoning='${2|medium,low,high|}') '${0:task}'"],
    "description": "Explicit model-directed runtime and MCP tool access"
  },
  "Enforce": {
    "prefix": "enforce",
    "body": ["enforce '${1:guidance}':", "    ${0:pass}"],
    "description": "Scoped positive prompt guidance, not runtime validation"
  },
  "Forbid": {
    "prefix": "forbid",
    "body": ["forbid '${1:guidance}':", "    ${0:pass}"],
    "description": "Scoped negative prompt guidance, not runtime enforcement"
  },
  "Restrict folder": {
    "prefix": "restrict",
    "body": ["restrict '${1:./folder}':", "    ${0:pass}"],
    "description": "Limit reads and writes to a folder"
  },
  "Restrict network": {
    "prefix": "restrictnet",
    "body": ["restrict net '${1:api.example.com}':", "    ${0:pass}"],
    "description": "Limit network access to hosts"
  },
  "Restrict exec": {
    "prefix": "restrictexec",
    "body": ["restrict exec '${1:git,npm}':", "    ${0:pass}"],
    "description": "Limit shell commands to executables"
  },
  "Restrict MCP": {
    "prefix": "restrictmcp",
    "body": ["restrict mcp '${1:docs/search}':", "    ${0:pass}"],
    "description": "Limit configured MCP servers or tools"
  },
  "Combined restrictions": {
    "prefix": "restrictmulti",
    "body": ["restrict '${1:./src}', exec '${2:git}', mcp '${3:docs/search}':", "    ${0:pass}"],
    "description": "Combine filesystem, executable and MCP restrictions"
  },
  "Read file": {
    "prefix": "read_file",
    "body": ["let ${1:content} = read_file('${0:./file}')"],
    "description": "Read exact text without a model"
  },
  "Write file": {
    "prefix": "write_file",
    "body": ["write_file('${1:./out/file}', ${0:text})"],
    "description": "Write exact text without a model"
  },
  "Fetch URL": {
    "prefix": "web_fetch",
    "body": ["let ${1:page} = web_fetch('${0:https://example.com}')"],
    "description": "Fetch response text without a model"
  },
  "Search the web": {
    "prefix": "web_search",
    "body": ["let ${1:hits} = web_search('${0:search terms}')"],
    "description": "Fetch search result text without a model"
  },
  "Shell": {
    "prefix": "shell",
    "body": ["let ${1:output} = shell('${0:git status}')"],
    "description": "Run a command without a model; nonzero exit raises tool_error"
  },
  "Assert": {
    "prefix": "assert",
    "body": ["assert ${1:condition} '${0:message}'"],
    "description": "Fail with assertion_failed when false"
  },
  "Fail": {
    "prefix": "fail",
    "body": ["fail '${0:reason}'"],
    "description": "Stop with explicit_failure"
  },
  "Success": {
    "prefix": "success",
    "body": ["success ${0:result}"],
    "description": "Stop successfully with a result"
  },
  "Model override": {
    "prefix": "model",
    "body": ["ask(model='${1:model-id}') '${0:prompt}'"],
    "description": "Override the document model for this generation"
  }
}

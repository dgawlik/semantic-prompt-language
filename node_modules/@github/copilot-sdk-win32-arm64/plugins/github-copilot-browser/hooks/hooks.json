{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node \"$COPILOT_BROWSER_PLUGIN_ROOT/scripts/activate.mjs\" --session-start",
        "powershell": "$ErrorActionPreference = 'Stop'; node (Join-Path $env:COPILOT_BROWSER_PLUGIN_ROOT 'scripts/activate.mjs') --session-start; exit $LASTEXITCODE",
        "env": {
          "COPILOT_BROWSER_PLUGIN_ROOT": "${PLUGIN_ROOT}"
        },
        "timeoutSec": 30
      }
    ]
  }
}

// ============================================================================
// 06_prompts_and_schemas.splx — @{ ... } Prompts, type_schema<T>() & decode<T>()
// ============================================================================
// Run:    node dist/cli.js run examples/06_prompts_and_schemas.splx
// Schema: node dist/cli.js schema examples/06_prompts_and_schemas.splx SecurityAudit

// --- 1. `///` Doc-Comments (IDE) vs `''` LLM Hints (JSON Schema) ---

/// Developer note (shown in IDE hover, omitted from JSON Schema to save tokens).
'' Severity level for a security finding.
pub enum Severity {
    Low      '' Informational or minor issue
    Medium   '' Should be addressed before release
    High     '' Exploitable vulnerability
}

'' Structured action emitted by an agent.
pub enum Remediation {
    Patch(Str)         '' Unified diff or code fix
    Escalate(Str, Int) '' Reason + priority level
    NoAction
}

/// Internal struct for persisting audit results.
'' Security audit report returned by an LLM agent.
pub type SecurityAudit = struct {
    /// Path relative to repository root
    file: Str                  '' Relative path of the audited file
    issue_count: Int           '' Total number of findings (integer)
    confidence: Float          '' Confidence score between 0.0 and 1.0
    severity: Severity         '' Highest severity discovered
    notes: Str?                '' Optional reviewer notes (omitted from JSON Schema `required`)
}

// Open record schema: emits `"additionalProperties": { "type": "integer" }`
'' Per-phase LLM token usage counters.
pub type TokenUsage = struct {
    model: Str                 '' Model identifier
    ..counters: Dict<Str, Int> '' Per-phase token counts
}

// --- 2. First-Class `Prompt` Blocks `@{ ... }` ---
// Accepts named parameters + a trailing `Prompt` block passed outside `(...)`.
fn simulate_agent(
    model: Str = "gpt-6-luna",
    tokens: Int = 1024,
    schema: Json,
    prompt: Prompt
) -> Result<(Str, Int, Str), Str> {
    // `Prompt` is a first-class value exposing `.text`, `.parts`, and `.render()`.
    Ok((prompt.render(), prompt.parts.len(), model + "/" + to_str(tokens)))
}

print("=== 06_prompts_and_schemas ===")

// Compile-time `type_schema<T>()` emits full JSON Schema with zero runtime reflection!
let audit_schema = type_schema<SecurityAudit>()
let usage_schema = type_schema<TokenUsage>()
let rem_schema = type_schema<Remediation>()

print("SecurityAudit schema: " + json_stringify(audit_schema))
print("TokenUsage schema:    " + json_stringify(usage_schema))
print("Remediation schema:   " + json_stringify(rem_schema))

// `@{ ... }` is auto-dedented, supports `${expr}` interpolation,
// and allows balanced `{ ... }` JSON examples without escaping!
let target_file = "src/auth.splx"
let example_sev = "High"
let call_res = simulate_agent(model: "gpt-6-luna", tokens: 2048, schema: audit_schema) @{
    Audit `${target_file}` for security bugs.
    Respond strictly as JSON matching:
    {"file": "${target_file}", "issue_count": 1, "confidence": 0.95, "severity": "${example_sev}"}
}

match call_res {
    Ok((rendered, part_count, meta)) => {
        print("Prompt (" + meta + ", " + to_str(part_count) + " static parts):")
        print(rendered)
    }
    Err(e) => print("Agent error: " + e)
}

// --- 3. Compile-Time Generated `decode<T>(json)` Validation ---
fn verify_audit(raw_json: Str) -> Result<SecurityAudit, Str> {
    let parsed = json_parse(raw_json)?
    match decode<SecurityAudit>(parsed) {
        Ok(audit) => Ok(audit)
        Err(e) => Err(e.path + ": " + e.message)
    }
}

// Valid JSON (optional `notes` omitted -> decoded as `None`)
let valid = verify_audit("{\"file\":\"src/auth.splx\",\"issue_count\":2,\"confidence\":0.92,\"severity\":\"High\"}")
print("decode valid:       " + to_str(valid))

// Invalid: Float provided for `Int` field `issue_count`
let bad_int = verify_audit("{\"file\":\"src/auth.splx\",\"issue_count\":2.5,\"confidence\":0.92,\"severity\":\"High\"}")
print("decode bad Int:     " + to_str(bad_int))

// Invalid: Unknown extra key on closed struct (`additionalProperties: false`)
let bad_extra = verify_audit("{\"file\":\"src/auth.splx\",\"issue_count\":1,\"confidence\":0.9,\"severity\":\"Low\",\"extra\":true}")
print("decode extra field: " + to_str(bad_extra))

// Open struct `TokenUsage`: unknown Int keys collected into `counters: Dict<Str, Int>`
fn verify_usage(raw_json: Str) -> Result<Str, Str> {
    let parsed = json_parse(raw_json)?
    let u = match decode<TokenUsage>(parsed) {
        Ok(v) => v
        Err(e) => return Err(e.path + ": " + e.message)
    }
    let prompt_toks = u["prompt_tokens"] ?? 0
    let comp_toks = u["completion_tokens"] ?? 0
    Ok("model=" + u.model + ", prompt=" + to_str(prompt_toks) + ", completion=" + to_str(comp_toks))
}

let usage_res = verify_usage("{\"model\":\"gpt-6-luna\",\"prompt_tokens\":120,\"completion_tokens\":45}")
print("decode open usage:  " + usage_res.unwrap_or("failed"))

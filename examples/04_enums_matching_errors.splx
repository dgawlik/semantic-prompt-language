// ============================================================================
// 04_enums_matching_errors.splx — ADTs, Exhaustive Match, Option<T> & Result<T, E>
// ============================================================================
// Run: node dist/cli.js run examples/04_enums_matching_errors.splx

// --- 1. Rust-like Tagged Enums (ADTs) ---
enum AgentStep {
    Think(Str)           // Internal reasoning text
    ToolCall(Str, Int)   // Tool name + retry count
    Finish(Str)          // Final response
    Abort                // Unit variant (no payload)
}

// Exhaustive pattern matching with guards
fn describe_step(step: AgentStep) -> Str {
    match step {
        Think(note) => "thinking: " + note
        ToolCall(name, retries) if retries > 2 => "tool '" + name + "' (high retries: " + to_str(retries) + ")"
        ToolCall(name, retries) => "tool '" + name + "' (attempt " + to_str(retries) + ")"
        Finish(out) => "finished: " + out
        Abort => "aborted"
    }
}

// --- 2. Pattern Matching on Open Records, Tuples & Arrays ---
fn route_event(ev: { kind: Str, name: Str, .. }) -> Str {
    match ev {
        { kind: "call", name, ..rest } => "dispatch " + name + " (extra=" + json_stringify(rest) + ")"
        { kind: "done", name, .. } => "completed " + name
        { kind, .. } => "ignored kind=" + kind
    }
}

fn summarize_list(xs: Array<Int>) -> Str {
    match xs {
        [] => "empty"
        [only] => "single(" + to_str(only) + ")"
        [first, second, ..rest] => "first=" + to_str(first) + ", second=" + to_str(second) + ", remaining=" + to_str(rest.len())
    }
}

// --- 3. No `null` / `undefined`: `Option<T>` (`T?`, `?.`, `??`) ---
type Contact = struct {
    email: Str?
}

type Account = struct {
    username: Str
    contact: Contact?
}

fn contact_email(acc: Account?) -> Str {
    // Optional chaining `?.` flat-maps nested Options cleanly
    acc?.contact?.email ?? "no-email@example.com"
}

// --- 4. Explicit Error Handling: `Result<T, E>` + Postfix `?` ---
fn parse_positive(s: Str) -> Result<Int, Str> {
    let j = json_parse(s)?
    let n = match decode<Int>(j) {
        Ok(v) => v
        Err(e) => return Err("not an Int (" + e.message + ")")
    }
    if n <= 0 {
        Err("must be > 0, got " + to_str(n))
    } else {
        Ok(n)
    }
}

fn sum_positive_pair(a: Str, b: Str) -> Result<Int, Str> {
    let x = parse_positive(a)?
    let y = parse_positive(b)?
    Ok(x + y)
}

print("=== 04_enums_matching_errors ===")
print(describe_step(Think("checking files")))
print(describe_step(ToolCall("grep", 1)))
print(describe_step(ToolCall("fetch", 4)))
print(describe_step(Finish("all clear")))
print(describe_step(Abort))

print(route_event({ kind: "call", name: "read_file", path: "README.md" }))
print(summarize_list([]))
print(summarize_list([99]))
print(summarize_list([10, 20, 30, 40]))

let alice: Account? = Some({ username: "alice", contact: Some({ email: Some("alice@spl.dev") }) })
let bob: Account? = Some({ username: "bob", contact: None })
let nobody: Account? = None
print("alice email: " + contact_email(alice))
print("bob email:   " + contact_email(bob))
print("nobody:      " + contact_email(nobody))

print("sum_positive_pair(10, 32): " + to_str(sum_positive_pair("10", "32")))
print("sum_positive_pair(10, -5): " + to_str(sum_positive_pair("10", "-5")))
print("sum_positive_pair(10, 3.5): " + to_str(sum_positive_pair("10", "3.5")))

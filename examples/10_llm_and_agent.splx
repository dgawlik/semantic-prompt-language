// ============================================================================
// 10_llm_and_agent.splx — Unified LLM Facade (`Prompt.ask` & `Prompt.agent`)
// ============================================================================
// Supports: "openai_responses", "openai_chat", "anthropic", "google"
// Set OPENAI_API_KEY (or ANTHROPIC_API_KEY / GEMINI_API_KEY) to run live;
// otherwise prints the prepared typed schemas and tool definitions cleanly.
// Run: node dist/cli.js run examples/10_llm_and_agent.splx

import llm, { Approve, Reject, Modify, ThinkLow, ToolAuto } from "std/llm"
import traces from "std/traces"
import os from "std/os"

/// Structured output returned by the LLM (verified via `decode<Summary>`).
'' Concise summary of a codebase check.
pub type Summary = struct {
    headline: Str  '' One-sentence headline
    risk_score: Int '' Risk score from 1 (low) to 10 (high)
}

type CalcArgs = struct {
    a: Int '' First operand
    b: Int '' Second operand
}

type CalcResult = struct {
    product: Int '' Product of a and b
}

/// Parameterized `llm.AgentTool<CalcArgs, CalcResult>`:
/// automatically derives `parameters = type_schema<CalcArgs>()`, decodes JSON into `CalcArgs`,
/// and serializes `CalcResult` back to the LLM.
fn make_calc_tool() -> llm.AgentTool<CalcArgs, CalcResult> {
    llm.tool<CalcArgs, CalcResult>(
        name: "multiply",
        description: "Multiplies two integers accurately"
    ) { args ->
        Ok({ product: args.a * args.b })
    }
}

fn run_live() -> Result<Unit, Str> {
    // 1. Parameterized single-turn `Prompt.ask<Summary>`:
    //    Defaults to provider: "openai_responses", model: "gpt-6-luna", and saved credentials / OPENAI_API_KEY.
    print_inline("ask<Summary> stream: ")
    let summary = @{
        Summarize why strong typing helps AI agents avoid tool-call errors.
    }.ask<Summary>(
        max_tokens: Some(256),
        stream: true,
        on_delta: Some({ d ->
            match d {
                llm.TextDelta(text) => print_inline(text)
                llm.ThinkingDelta(text) => print_inline(text)
                llm.SummaryDelta(text) => print_inline(text)
                _ => ()
            }
        })
    )?
    print("")
    print("ask headline: " + summary.headline + " (risk=" + to_str(summary.risk_score) + ")")

    // 2. Parameterized multi-turn `Prompt.agent<Str>`:
    //    Because `T = Str`, no JSON schema is enforced and plain `Str` is returned with `ExecutionTrace`.
    print_inline("agent<Str> stream: ")
    let (answer_text, trace) = @{
        Use the multiply tool to compute 17 * 23 and report the answer.
    }.agent<Str>(
        tool_choice: Some(ToolAuto),
        tools: [make_calc_tool()],
        stream: true,
        on_delta: Some({ d ->
            match d {
                llm.TextDelta(text) => print_inline(text)
                llm.ThinkingDelta(text) => print_inline(text)
                llm.SummaryDelta(text) => print_inline(text)
                _ => ()
            }
        }),
        on_decision: Some({ req ->
            if req.tool_call.name == "multiply" { Approve } else { Reject("unknown tool") }
        })
    )?
    print("")

    print("agent answer: " + answer_text)
    let event_kinds = trace.events.map { ev -> ev.kind_name() }
    print("agent trace:  turns=" + to_str(trace.turns) + ", events=" + to_str(event_kinds) + ", total_ms=" + to_str(trace.total_duration_ms))

    // 3. Serialize trace to JSONL (`std/traces`) and replay deterministically through Turn 1
    let jsonl = traces.to_jsonl(trace)
    traces.save_jsonl("trace.jsonl", trace)
    let loaded = traces.from_jsonl(jsonl)?
    let (replayed, replay_trace) = llm.agent_replay<Str>(
        trace: loaded,
        up_to_step: loaded.events.len()
    )?
    print("replay answer (0 live calls): " + replayed + " (events=" + to_str(replay_trace.step_count()) + ")")
    Ok(())
}

// 3. Decisions API (`llm.decide`): supports OpenAI `/v1/decisions` (`gpt-6-luna`)
//    and Google Gemini `/v1beta/decisions` (`gemini-decision-1`)
fn classify_ticket(ticket: Str) -> Result<llm.DecisionsResponse, Str> {
    let qs = [
        llm.predicate("needs_refund", "Is the customer requesting a refund?"),
        llm.choice("department", "Which team should handle this?", [
            ("billing", Some("Payments, invoices, or refunds")),
            ("shipping", Some("Delivery or transit issues")),
            ("other", None)
        ]),
        llm.score("urgency", "Rate urgency from 0 to 2", ["low", "medium", "high"])
    ]
    llm.decide(questions: qs) @{
        Customer ticket: ${ticket}
    }
}

print("=== 10_llm_and_agent ===")
let calc = make_calc_tool()
print("Summary schema: " + json_stringify(type_schema<Summary>()))
print("Tool schema:    " + json_stringify(calc.parameters))

match os.env("OPENAI_API_KEY") {
    Some(key) if key.trim() != "" => {
        match run_live() {
            Ok(_) => print("Live LLM run succeeded")
            Err(e) => print("Live LLM error: " + e)
        }
    }
    _ => print("Set OPENAI_API_KEY to execute live requests (offline schema/tool check passed).")
}

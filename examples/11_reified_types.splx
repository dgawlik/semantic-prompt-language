// ============================================================================
// 11_reified_types.splx — Reifiable Types (`reified fn`, `type_schema<T>`, `decode<T>`)
// ============================================================================
// Run: node dist/cli.js run examples/11_reified_types.splx

import codegen from "std/codegen"

// --- 1. Domain Types with `''` LLM Hints ---

'' Priority level for a task item.
pub enum Priority {
    Low      '' Can be deferred
    Normal   '' Standard sprint work
    Urgent   '' Drop everything and fix
}

'' A single work item tracked by an agent.
pub type Task = struct {
    id: Int            '' Unique numeric task ID
    title: Str         '' Short task summary
    priority: Priority '' Task priority
    assignee: Str?     '' Optional owner handle
}

'' A generic API response envelope parameterized by payload `T`.
pub type Envelope<T> = struct {
    ok: Bool           '' Whether the request succeeded
    data: T            '' Typed payload
}

// --- 2. Generic `reified fn<T>`: Preserves Runtime Schema + Decoder Codec ---
// Unlike normal generic functions (where `T` is erased at runtime), a `reified fn`
// receives compile-time type descriptors (JSON Schema + runtime validation codec)
// automatically injected at every call site!

/// Parses a JSON string and validates it against any reified type `T`.
pub reified fn parse_json<T>(raw: Str) -> Result<T, Str> {
    let parsed = json_parse(raw)?
    match decode<T>(parsed) {
        Ok(val) => Ok(val)
        Err(e) => Err("Decode error at " + e.path + ": " + e.message)
    }
}

/// Returns the JSON Schema string for any reified type `T` at runtime.
pub reified fn schema_json<T>() -> Str {
    json_stringify(type_schema<T>())
}

// --- 3. Compound & Forwarded Reified Types (`Array<T>`, `Envelope<T>`, `T?`) ---
// Reified type parameters compose seamlessly inside generic containers and can
// be forwarded to other `reified fn`s (including `std/codegen` and `std/llm`).

/// Parses a JSON array of `T` by forwarding `Array<T>` into `parse_json`.
pub reified fn parse_batch<T>(raw: Str) -> Result<Array<T>, Str> {
    parse_json<Array<T>>(raw)
}

/// Builds a schema for `Envelope<Array<T>>` dynamically from the reified `T`.
pub reified fn batch_envelope_schema<T>() -> Json {
    type_schema<Envelope<Array<T>>>()
}

/// Evaluates a sandboxed JS expression and validates its result as `T`
/// by forwarding the reified type parameter `T` directly into `codegen.js_eval<T>`.
pub reified fn eval_typed<T>(js_expr: Str) -> Result<T, Str> {
    codegen.js_eval<T>(js_expr)
}

/// Validates JSON against `T`, returning the expected JSON Schema on failure
/// (useful for feeding structured retry prompts back to an LLM).
pub reified fn validate_or_prompt<T>(raw: Str) -> Result<T, Str> {
    match parse_json<T>(raw) {
        Ok(v) => Ok(v)
        Err(err) => {
            let expected = schema_json<T>()
            Err(err + " | expected schema: " + expected)
        }
    }
}

// --- 4. Run All Examples ---

print("=== 11_reified_types ===")

// A. Reified `schema_json<T>()` works on structs, enums, and generic containers
print("Task schema:     " + schema_json<Task>())
print("Priority schema: " + schema_json<Priority>())

// B. Reified `parse_json<T>(raw)` decodes and validates arbitrary types
let task_res = parse_json<Task>("{\"id\":1,\"title\":\"Ship reified types\",\"priority\":\"Urgent\"}")
match task_res {
    Ok(t) => print("parsed Task:     id=" + to_str(t.id) + ", title=" + t.title + ", priority=" + to_str(t.priority) + ", assignee=" + (t.assignee ?? "unassigned"))
    Err(e) => print("unexpected err:  " + e)
}

// C. Compound reified types: `Array<Task>` and `Envelope<Array<Task>>`
let batch_json = "[{\"id\":1,\"title\":\"Design\",\"priority\":\"Low\"},{\"id\":2,\"title\":\"Build\",\"priority\":\"Normal\",\"assignee\":\"alice\"}]"
let batch = parse_batch<Task>(batch_json).unwrap_or([])
print("parsed batch:    " + to_str(batch.len()) + " tasks, second=" + (batch[1]?.title ?? ""))

let env_json = "{\"ok\":true,\"data\":{\"id\":7,\"title\":\"Verify\",\"priority\":\"Urgent\"}}"
match parse_json<Envelope<Task>>(env_json) {
    Ok(env) => print("parsed Envelope: ok=" + to_str(env.ok) + ", data.id=" + to_str(env.data.id))
    Err(e) => print("envelope err:    " + e)
}

let env_schema = batch_envelope_schema<Task>()
print("envelope schema: " + json_stringify(env_schema))

// D. Forwarding reified `T` to `std/codegen` (`codegen.js_eval<T>`)
let computed = eval_typed<Task>("({ id: 40 + 2, title: 'Generated', priority: 'High'.replace('High', 'Urgent') })")
match computed {
    Ok(t) => print("eval_typed Task: id=" + to_str(t.id) + ", title=" + t.title)
    Err(e) => print("eval_typed err:  " + e)
}

// E. Runtime validation error with automatic schema feedback
let bad = validate_or_prompt<Task>("{\"id\":\"not-an-int\",\"title\":\"Oops\",\"priority\":\"Urgent\"}")
print("invalid decode:  is_err=" + to_str(bad.is_err()))
match bad {
    Ok(_) => ()
    Err(msg) => print("feedback:        " + msg)
}

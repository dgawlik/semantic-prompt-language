

fn fnv1a_hash(str: String) -> Int {
    let mut hash = 2166136261
    for c in str.chars() {
        hash = hash ^ (c as Int)
        hash = hash * 16777619
    }
    hash
}


let text = """
QuickSort is a sorting algorithm based on the Divide and Conquer 
that picks an element as a pivot and partitions 
the given array around the picked pivot by placing 
the pivot in its correct position in the sorted array.
"""

let hash = fnv1a_hash(text)
print(hash)



fn partition(arr: Array<Int>, low: Int, high: Int) -> Int {
    let pivot = arr.get(high) ?? 0
    let mut i = low - 1
    for j in low..high {
        if arr.get(j) ?? 0 <= pivot {
            i = i + 1
            let temp = arr.get(i) ?? 0
            arr.set(i, arr.get(j) ?? 0)
            arr.set(j, temp)
        }
    }
    let temp = arr.get(i + 1) ?? 0
    arr.set(i + 1, arr.get(high) ?? 0)
    arr.set(high, temp)
    i + 1
}

fn quicksort(arr: Array<Int>, low: Int, high: Int) -> Array<Int> {
    if low < high {
        let pi = partition(arr, low, high)
        quicksort(arr, low, pi - 1)
        quicksort(arr, pi + 1, high)
    }
    arr
}


let arr = [3, 6, 8, 10, 1, 2, 1]
let sorted = quicksort(arr, 0, arr.len() - 1)
print(sorted)

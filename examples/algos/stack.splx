

type Stack<T> = {
    elements: Array<T>
    length: Int
}

fn Stack<T>.push(mut self, item: T) {
    self.elements = self.elements.concat([item])
    self.length = self.length + 1
}

fn Stack<T>.pop(mut self) ->  T? {
    if self.length == 0 {
        None
    } else {
       let popped_item = self.elements[self.length - 1]
       self.elements = self.elements.slice(0, self.length - 1)
       self.length = self.length - 1
       popped_item
    }
}

let mut stack = { elements: [], length: 0 }
stack.push(1)
stack.push(2)
let popped = stack.pop()

print(popped)
print(stack)


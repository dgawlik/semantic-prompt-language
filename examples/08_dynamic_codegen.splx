// ============================================================================
// 08_dynamic_codegen.splx — Typed Dynamic JS & SPL Code Generation (`std/codegen`)
// ============================================================================
// Run: node dist/cli.js run examples/08_dynamic_codegen.splx

import codegen from "std/codegen"
import os from "std/os"

type CalcInput = struct {
    a: Int '' First integer operand
    b: Int '' Second integer operand
}

type CalcOutput = struct {
    sum: Int     '' a + b
    product: Int '' a * b
}

fn run_demo() -> Result<Unit, Str> {
    print("=== 08_dynamic_codegen ===")

    // --- 1. Strongly-Typed Sandboxed JS Function (`codegen.js_fn<In, Out>`) ---
    // Accepts either a string or a brace-balanced `@{ ... }` block!
    // Input `CalcInput` is checked at COMPILE TIME;
    // Output `CalcOutput` is validated at RUNTIME via `decode<CalcOutput>`.
    let calc_js = codegen.js_fn<CalcInput, CalcOutput> @{
        return { sum: input.a + input.b, product: input.a * input.b };
    }?
    let r1 = calc_js({ a: 6, b: 7 })?
    print("js_fn: sum=" + to_str(r1.sum) + ", product=" + to_str(r1.product))

    // Bad JS output is caught safely as `Err(...)` — SPL's strong typing stays intact!
    let buggy_js = codegen.js_fn<CalcInput, CalcOutput> @{
        return { sum: 'not-an-int', product: 0 };
    }?
    print("js_fn bad output: " + to_str(buggy_js({ a: 1, b: 2 })))

    // Infinite loops are stopped by `timeout_ms` in the Node VM sandbox
    let looper = codegen.js_fn<Int, Int>(timeout_ms: 50) @{
        while (true) {}
    }?
    print("js_fn timeout:    " + to_str(looper(1)))

    // --- 2. Async JS Function (`codegen.js_async_fn<In, Out>`) ---
    // Participates seamlessly in SPL's transparent colorless async!
    let async_double = codegen.js_async_fn<Int, Int> @{
        return await Promise.resolve(input * 2);
    }?
    let r2 = async_double(21)?
    print("js_async_fn(21):  " + to_str(r2))

    // --- 3. One-Shot Typed JS Eval (`codegen.js_eval<Out>`) ---
    let computed = codegen.js_eval<Int> @{
        Array.from({length: 5}, (_, i) => i + 1).reduce((a, b) => a + b, 0)
    }?
    print("js_eval sum 1..5: " + to_str(computed))

    // --- 4. Runtime SPL Compiler (`codegen.spl_fn<In, Out>`) ---
    // Dynamically lexes, parses, TYPE-CHECKS against `fn(CalcInput) -> CalcOutput`,
    // and compiles SPL source code into a callable typed function!
    let calc_spl = codegen.spl_fn<CalcInput, CalcOutput> @{
        pub fn run(input) {
            { sum: input.a + input.b, product: input.a * input.b }
        }
    }?
    let r3 = calc_spl({ a: 10, b: 20 })?
    print("spl_fn: sum=" + to_str(r3.sum) + ", product=" + to_str(r3.product))

    // Type-invalid generated SPL is rejected at compile time BEFORE executing!
    let bad_spl = codegen.spl_fn<CalcInput, CalcOutput> @{
        pub fn run(input) { { sum: "wrong", product: 0 } }
    }
    print("spl_fn type err:  " + to_str(bad_spl.is_err()))

    // --- 5. LLM-Synthesized Typed JS Function (`codegen.llm_fn<In, Out>`) ---
    // Generates sandboxed JS from a `@{ ... }` description + `In`/`Out` JSON Schemas!
    match os.env("OPENAI_API_KEY") {
        Some(key) if key.trim() != "" => {
            let calc_llm = codegen.llm_fn<CalcInput, CalcOutput>(
                provider: "openai_responses",
                api_key: key,
                model: "gpt-4.1-mini"
            ) @{
                Compute sum (a + b) and product (a * b) of the input integers.
            }?
            let r4 = calc_llm({ a: 9, b: 8 })?
            print("llm_fn: sum=" + to_str(r4.sum) + ", product=" + to_str(r4.product))
        }
        _ => print("llm_fn: set OPENAI_API_KEY to synthesize live JS function via LLM")
    }
    Ok(())
}

let res = run_demo()
match res {
    Ok(_) => print("08_dynamic_codegen completed cleanly")
    Err(e) => print("Error: " + e)
}

// ============================================================================
// 01_basics.splx — Primitives, Bindings, Operators, Math, Regex & Control Flow
// ============================================================================
// Run: node dist/cli.js run examples/01_basics.splx

// --- 1. Primitives & Bindings ---
// `let` bindings are immutable by default; inner blocks can shadow outer names.
let base_answer: Int = 42
let answer: Int = {
    let base_answer = base_answer + 8 // Shadows outer `base_answer` -> 50
    base_answer
}
let pi: Float = 3.14159
let active: Bool = true
let grade: Char = 'A'                // Single quotes are `Char` literals
let greeting: Str = "Hello, SPL!"    // Double quotes are `Str` literals
let interp: Str = "answer=${answer}, grade=${grade}" // String interpolation

// `let mut` allows local rebinding within its lexical scope.
let mut counter = 0
while counter < 5 {
    counter = counter + 1
}

// --- 2. Operators ---
// Int division truncates toward zero; Float division is IEEE-754 floating point.
let int_div: Int = 7 / 2             // 3
let int_mod: Int = 7 % 2             // 1
let power: Int = 2 ** 10             // 1024
let float_div: Float = 7.0 / 2.0     // 3.5

// Bitwise operators on Int
let mask: Int = (1 << 4) | (3 & 1)   // 17
let xor_val: Int = 10 ^ 6            // 12
let shifted: Int = 32 >> 2           // 8

// Short-circuit boolean logic & comparisons
let logic: Bool = active && (int_div == 3) && !(counter < 5)

// --- 3. Math & Numeric Conversions ---
let root: Float = sqrt(16.0)
let floored: Int = floor(pi)         // 3
let ceiled: Int = ceil(pi)           // 4
let rounded: Int = round(3.6)        // 4
let as_float: Float = int_to_float(answer)
let as_int: Int = float_to_int(pi)
let finite_ok: Bool = is_finite(as_float)

// --- 4. Expression-Oriented `if / else if / else` & Blocks ---
let label = if counter > 10 {
    "large"
} else if counter == 5 {
    let tag = "exact"
    tag + ":5"                       // Last expression is the block's value
} else {
    "small"
}

// --- 5. Strings, Bytes & Regex Builtins ---
let clean = "  semantic prompt language  ".trim().to_upper()
let words = clean.split(" ")
let has_prompt = clean.contains("PROMPT")
let replaced = clean.replace("LANGUAGE", "LANG")

let raw_bytes: Bytes = bytes_from_utf8("SPL")
let byte_count: Int = bytes_len(raw_bytes)
let roundtrip: Str = bytes_to_utf8(raw_bytes)

let is_semver = regex_test("^[0-9]+\\.[0-9]+\\.[0-9]+$", "0.1.0")
let redacted = regex_replace("[0-9]+", "order-12345", "XXX")

print("=== 01_basics ===")
print(interp)
print("int_div=" + to_str(int_div) + ", float_div=" + to_str(float_div) + ", power=" + to_str(power))
print("bitwise: mask=" + to_str(mask) + ", xor=" + to_str(xor_val) + ", shifted=" + to_str(shifted))
print("math: sqrt=" + to_str(root) + ", floor=" + to_str(floored) + ", ceil=" + to_str(ceiled) + ", round=" + to_str(rounded))
print("conversions: " + to_str(as_int) + ", finite=" + to_str(finite_ok) + ", logic=" + to_str(logic))
print("label=" + label + ", words=" + to_str(words.len()) + ", has_prompt=" + to_str(has_prompt))
print("replaced=" + replaced)
print("bytes=" + to_str(byte_count) + " (" + roundtrip + "), semver=" + to_str(is_semver) + ", redacted=" + redacted)

// ============================================================================
// 05_traits_extensions_modules.splx — Modules, Traits, Coherence & Extensions
// ============================================================================
// Run: node dist/cli.js run examples/05_traits_extensions_modules.splx

// 1 file = 1 module: supports named imports, aliases, and namespace imports.
import { Point, Meters, Feet, Describable, distance as dist_between } from "./lib/geometry"
import geo from "./lib/geometry"

// Local extension method scoped to this module:
// Works on any record containing `name: Str` (row-polymorphic receiver!).
fn { name: Str, .. }.shout(self) -> Str {
    self.name.to_upper() + "!"
}

// Local trait implementation for a custom record shape
type Badge = struct {
    title: Str
    level: Int
}

impl Show for Badge {
    fn show(self) -> Str {
        "[" + self.title + " L" + to_str(self.level) + "]"
    }
}

// Generic function constrained by a trait bound
fn log_described<T: Describable>(label: Str, item: T) -> Unit {
    print(label + ": " + to_str(item))
}

print("=== 05_traits_extensions_modules ===")

let p1 = Point { x: 3.0, y: 4.0 }
let p2 = { x: 0.0, y: 0.0 } // Structurally compatible with `Point`!

// Calling trait method (`describe`), imported extension method (`distance_from_origin`),
// aliased function (`dist_between`), and namespace function (`geo.distance`).
print("p1.describe()            = " + p1.describe())
print("p1.distance_from_origin  = " + to_str(p1.distance_from_origin()))
print("dist_between(p1, p2)     = " + to_str(dist_between(p1, p2)))
print("geo.distance(p1, p2)     = " + to_str(geo.distance(p1, p2)))

// Nominal single-variant enums allow distinct `Show` impls on the same underlying `Float`
let m = Meters(10.5)
let f = Feet(34.4)
print("units: " + m.show() + " / " + f.show())

// Local extension method works on any anonymous record with `name: Str`
let labeled_point = { x: 6.0, y: 8.0, name: "origin-offset" }
print("labeled_point.shout()    = " + labeled_point.shout())
print("labeled_point.dist       = " + to_str(labeled_point.distance_from_origin()))

let badge = { title: "Architect", level: 5 }
print("badge.show()             = " + badge.show())
log_described("point", p1)

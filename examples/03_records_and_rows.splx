// ============================================================================
// 03_records_and_rows.splx — Structs, Structural Equivalence, Row Polymorphism & Open Records
// ============================================================================
// Run: node dist/cli.js run examples/03_records_and_rows.splx

// --- 1. Named Struct with `///` Doc-Comments & `''` LLM Hints ---
/// Developer doc-comment: customer record used in reservation logic.
'' Represents a registered restaurant customer.
type Person = struct {
    /// Legal given name
    firstName: Str '' Given name (e.g. "Ada")
    lastName: Str  '' Family name (e.g. "Lovelace")
    age: Int       '' Age in whole years
}

// --- 2. Hybrid Open Record (`..extra: Dict<Str, V>`) ---
// Known fields get static dot access (`.id`, `.kind`) with full autocomplete;
// unknown runtime keys use safe bracket indexing (`ev["key"]` -> `Json?`).
type ToolEvent = struct {
    id: Str   '' Unique event identifier
    kind: Str '' Event type ("call", "result", "error")
    ..extra: Dict<Str, Json> '' Arbitrary extra payload properties
}

// --- 3. Structural Equivalence ---
// Accepts `Person` OR any anonymous record with identical fields.
fn format_person(p: Person) -> Str {
    "${p.firstName} ${p.lastName} (age ${p.age})"
}

// --- 4. Row Polymorphism (`..r`) ---
// Requires at least `firstName: Str`, ignoring any extra fields.
fn greet_any(x: { firstName: Str, .. }) -> Str {
    "Hello, " + x.firstName + "!"
}

// Fully inferred row-polymorphic transform: `fn({ ..r }) -> { ts: Int, ..r }`
// Preserves every field of the input record on the returned type!
fn with_timestamp(x) {
    { ...x, ts: 1700000000 }
}

print("=== 03_records_and_rows ===")

// Anonymous structural record literal + field shorthand
let firstName = "Ada"
let lastName = "Lovelace"
let anon_person = { firstName, lastName, age: 36 }
let explicit_person = Person { firstName: "Ada", lastName: "Lovelace", age: 36 }

// Deep structural equality works across anonymous & named structs
print("structurally equal: " + to_str(anon_person == explicit_person))
print("format_person: " + format_person(anon_person))

// Functional spread `{ ...base, newField: val }` grows the static type
let admin = { ...anon_person, role: "admin" }
print("greet_any(admin): " + greet_any(admin))

// Row polymorphism preserves `firstName`, `lastName`, `age`, AND `role` alongside `ts`!
let tagged = with_timestamp(admin)
print("tagged: " + tagged.firstName + ", role=" + tagged.role + ", ts=" + to_str(tagged.ts))

// Hybrid open record: decode runtime JSON with extra dynamic keys
fn inspect_event(raw: Str) -> Result<Str, Str> {
    let parsed = json_parse(raw)?
    let ev = match decode<ToolEvent>(parsed) {
        Ok(v) => v
        Err(e) => return Err(e.path + ": " + e.message)
    }
    // Static dot access on known fields, dynamic bracket access returning `Json?`
    let model = ev["model"]
    let missing = ev["nonexistent"]
    Ok("id=" + ev.id + ", kind=" + ev.kind + ", has_model=" + to_str(model.is_some()) + ", has_missing=" + to_str(missing.is_some()) + ", extra_count=" + to_str(ev.extra.len()))
}

let ev_res = inspect_event("{\"id\":\"evt-1\",\"kind\":\"call\",\"model\":\"gpt-6-luna\",\"tokens\":256}")
print("open record: " + ev_res.unwrap_or("failed"))

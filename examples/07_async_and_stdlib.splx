// ============================================================================
// 07_async_and_stdlib.splx — Transparent (Colorless) Async & Standard Library
// ============================================================================
// Run: node dist/cli.js run examples/07_async_and_stdlib.splx

// Universal stdlib modules (Browser + Node/Bun/Deno)
import clock from "std/clock"
import crypto from "std/crypto"
import console from "std/console"

// Server-only stdlib modules (Node/Bun/Deno)
import fs from "std/fs"
import proc from "std/proc"
import os from "std/os"

// --- 1. Colorless Async ---
// Notice there are NO `async` or `await` keywords anywhere in SPL!
// Pure functions compile to plain synchronous JS; suspending functions
// automatically compile to JS `async function` with `await` inserted.

fn pure_triple(n: Int) -> Int {
    n * 3
}

fn delayed_triple(n: Int) -> Int {
    clock.sleep(20)
    pure_triple(n)
}

fn run_all() -> Result<Unit, Str> {
    console.log("=== 07_async_and_stdlib ===")

    // Sequential `map` (default — prevents accidental unbounded LLM fan-out)
    let t0 = clock.now_ms()
    let seq = [1, 2, 3].map { x -> delayed_triple(x) }
    let seq_ms = clock.now_ms() - t0

    // Opt-in concurrent `par_map` (`Promise.all`)
    let t1 = clock.now_ms()
    let par = [1, 2, 3].par_map { x -> delayed_triple(x) }
    let par_ms = clock.now_ms() - t1

    print("sequential map: " + to_str(seq) + " in " + to_str(seq_ms) + "ms")
    print("parallel par_map: " + to_str(par) + " in " + to_str(par_ms) + "ms")

    // `async_all` & `async_race` combinators
    let all_vals = async_all([
        { -> delayed_triple(10) },
        { -> delayed_triple(20) }
    ])
    let winner = async_race([
        { -> clock.sleep(30); "slow" },
        { -> clock.sleep(5); "fast" }
    ])
    print("async_all=" + to_str(all_vals) + ", async_race=" + winner)

    // --- 2. Universal `std/crypto` ---
    let token = crypto.random_hex(8)
    print("random_hex(8) = " + token)

    // --- 3. Server `std/os` & `std/proc` ---
    print("platform=" + os.platform() + ", cwd=" + os.cwd())
    let home = os.env("HOME") ?? os.env("USERPROFILE") ?? "<unknown>"
    print("home set: " + to_str(home != "<unknown>"))

    let sh = proc.shell("echo hello-from-spl-proc")?
    print("proc.shell exit=" + to_str(sh.code) + ", stdout=" + sh.stdout.trim())

    // --- 4. Server `std/fs` + Pure SPL Path Helpers ---
    let tmp_dir = fs.join_path(os.cwd(), ".spl-example-tmp")
    let sample_file = fs.join_path(tmp_dir, "note.txt")
    fs.mkdir(tmp_dir)?
    fs.write(sample_file, "Written by SPL std/fs!")?

    let content = fs.read(sample_file)?
    let st = fs.stat(sample_file)?
    let entries = fs.list_dir(tmp_dir)?
    let ext = fs.ext_name(sample_file) ?? ""
    print("fs.read=" + content + ", size=" + to_str(st.size) + ", ext=." + ext + ", entries=" + to_str(entries))

    // Clean up temporary directory
    fs.remove(tmp_dir)?
    Ok(())
}

let res = run_all()
match res {
    Ok(_) => print("07_async_and_stdlib completed cleanly")
    Err(e) => console.error("Error: " + e)
}

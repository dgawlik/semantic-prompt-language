
import llm from "std/llm"

type Person =  {
    firstName: String '' Ada
    lastName: String '' Lovelace
    age: Int 
    profession: String
}

// Defaults to provider: "openai_responses", model: "gpt-6-luna", and api_key from ~/.spl/credentials.json (`spl login`) or OPENAI_API_KEY.
let ada = @{ 
    Generate person
}.ask<Person>()?
print("Person[${ada.firstName} ${ada.lastName}" + 
        ", age ${ada.age}, profession ${ada.profession}]")
                          

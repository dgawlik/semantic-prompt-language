def _normalize(text: str) -> str:
    return text.replace('\r\n', '\n').replace('\r', '\n')


def _line(text: str) -> str:
    assert '\n' not in text and '\r' not in text 'Markdown inline text must not contain newlines'
    return text


def _fence(text: str, minimum: int) -> str:
    let longest: int = 0
    let current: int = 0
    for character in text:
        if character == '`':
            current += 1
            longest = max(longest, current)
        else:
            current = 0
    return '`' * max(minimum, longest + 1)


def escape(text: str) -> str:
    let result = ''
    for character in text:
        if character in '\\`*_\{\}[]<>()#+-.!|~>&':
            result += '\\'
        result += character
    return result


def bold(text: str) -> str:
    return '**' + _line(text) + '**'


def italic(text: str) -> str:
    return '*' + _line(text) + '*'


def code(text: str) -> str:
    let content = _normalize(text).replace('\n', ' ')
    assert content != '' 'Markdown inline code must not be empty'
    let fence = _fence(content, 1)
    if content.startswith('`') or content.endswith('`') or (content.startswith(' ') and content.endswith(' ') and content.strip() != ''):
        content = ' ' + content + ' '
    return fence + content + fence


def _destination(url: str) -> str:
    return url.replace('\\', '%5C').replace('<', '%3C').replace('>', '%3E').replace(' ', '%20').replace('\t', '%09').replace('\r', '%0D').replace('\n', '%0A')


def link(label: str, url: str) -> str:
    return '[' + escape(_line(label)) + '](<' + _destination(url) + '>)'


def image(alt: str, url: str) -> str:
    return '!' + link(alt, url)


def _cell(text: str) -> str:
    let result = ''
    let slashes: int = 0
    for character in _normalize(text):
        if character == '|' and slashes % 2 == 0:
            result += '\\'
        if character == '\n':
            result += '<br>'
        else:
            result += character
        if character == '\\':
            slashes += 1
        else:
            slashes = 0
    return result


def _row(cells: list[str]) -> str:
    let values: list[str] = []
    for cell in cells:
        values.append(_cell(cell))
    return '| ' + ' | '.join(values) + ' |'


class Document:
    blocks: list[str]

    def Document():
        self.blocks = []

    def raw(text: str) -> Document:
        if text != '':
            self.blocks.append(_normalize(text))
        return self

    def heading(text: str, level: int) -> Document:
        assert 1 <= level and level <= 6 'Markdown heading level must be between 1 and 6'
        return self.raw('#' * level + ' ' + _line(text))

    def paragraph(text: str) -> Document:
        return self.raw(text)

    def bullet_list(items: list[str]) -> Document:
        let lines: list[str] = []
        for item in items:
            lines.append('- ' + _normalize(item).replace('\n', '\n  '))
        return self.raw('\n'.join(lines))

    def ordered_list(items: list[str], start: int) -> Document:
        assert 0 <= start and start + int(len(items)) <= 1000000000 'Markdown ordered list numbers must have at most nine digits'
        let lines: list[str] = []
        let number: int = start
        for item in items:
            let prefix = str(number) + '. '
            lines.append(prefix + _normalize(item).replace('\n', '\n' + ' ' * len(prefix)))
            number += 1
        return self.raw('\n'.join(lines))

    def quote(text: str) -> Document:
        return self.raw('> ' + _normalize(text).replace('\n', '\n> '))

    def code_block(text: str, language: str) -> Document:
        assert '`' not in _line(language) 'Markdown code block language must not contain backticks'
        let fence = _fence(text, 3)
        let content = _normalize(text)
        if content != '' and not content.endswith('\n'):
            content += '\n'
        return self.raw(fence + language + '\n' + content + fence)

    def table(headers: list[str], rows: list[list[str]]) -> Document:
        assert len(headers) > 0 'Markdown tables require at least one column'
        let separators: list[str] = []
        for header in headers:
            separators.append('---')
        let lines: list[str] = [_row(headers), _row(separators)]
        for row in rows:
            assert len(row) == len(headers) 'Markdown table row width must match the headers'
            lines.append(_row(row))
        return self.raw('\n'.join(lines))

    def thematic_break() -> Document:
        return self.raw('---')

    def to_string() -> str:
        if len(self.blocks) == 0:
            return ''
        return '\n\n'.join(self.blocks) + '\n'

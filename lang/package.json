{
  "name": "spl-lang",
  "version": "3.5.0",
  "description": "Semantic Prompt Language: natural-language instructions for models and agents, interleaved with TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown-lib.d.ts",
      "default": "./dist/markdown-lib.js"
    },
    "./globals": {
      "types": "./globals.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "spl": "dist/cli.js",
    "spl-lang": "dist/cli.js"
  },
  "files": [
    "dist",
    "globals.d.ts",
    "examples"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('../docs/assets/style.css','dist/style.css')\"",
    "prepare": "npm run build",
    "test": "npm run build && vitest run",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "llm",
    "agents",
    "typescript",
    "workflow",
    "structured-output"
  ],
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.88",
    "@anthropic-ai/sdk": "^1.4.0",
    "@google/genai": "^3.3.0",
    "@types/node": "^26.6.5",
    "acorn": "^8.19.0",
    "ajv": "^8.17.1",
    "highlight.js": "^11.12.0",
    "ink": "^8.0.0",
    "marked": "^18.1.1",
    "openai": "^7.48.0",
    "react": "^19.3.1",
    "string-width": "^8.3.0",
    "typescript": "^7.0.2",
    "wrap-ansi": "^10.0.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "vitest": "^5.0.5"
  }
}

{
  "name": "spl-lang",
  "version": "1.15.1",
  "description": "Semantic Prompt Language: a Python-like language with LLM calls built into the syntax",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "spl": "dist/cli.js",
    "spl-lang": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && vitest run",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "llm",
    "language",
    "copilot"
  ],
  "license": "ISC",
  "dependencies": {
    "@bettertui/core": "0.1.1",
    "@ai-sdk/mcp": "^2.0.88",
    "@anthropic-ai/sdk": "^1.4.0",
    "@google/genai": "^2.32.0",
    "openai": "^7.48.0",
    "ajv": "^8.17.1",
    "marked": "^18.1.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

//*
# Repository agentic operations

An agent reads the repository it runs in and reports what it finds as typed data;
plain code decides what to do about it.

    spl run examples/repo.spl
*//

---
model: gpt-6-luna
---

const Issue = Struct('Issue', {
    name: Str,
    cwe: Str.describe('CWE id, such as CWE-79'),
    file: Str.describe('Path of the affected file'),
    description: Str,
});

const Vulnerabilities = Struct('Vulnerabilities', { high: List(Issue), medium: List(Issue), low: List(Issue) });

---
mode: agent

Read the repository you are in and list its security vulnerabilities,
grouped by severity ->[Vulnerabilities] @vulnerabilities
---

log(vulnerabilities);
const { high, medium, low } = vulnerabilities;

if (high.length > 0) fail(`High vulnerabilities found. Fix this one first ${JSON.stringify(high[0])}`);
for (const item of medium) log('Medium vulnerability found:', item);
if (medium.length === 0) for (const item of low) log('Low vulnerability found:', item);
success('Analyzed');

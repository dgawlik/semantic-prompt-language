# @CODEGEN sha256:0bf6d0586753d772a87e4af0b9177236e64e481f18c5345569e6a82e3ff35427
def sieve(number):
    if number < 2:
        return []
    let is_prime = range(number + 1).map(lambda value: True)
    is_prime[0] = False
    is_prime[1] = False
    let candidate = 2
    while candidate * candidate <= number:
        if is_prime[candidate]:
            let multiple = candidate * candidate
            while multiple <= number:
                is_prime[multiple] = False
                multiple = multiple + candidate
        candidate = candidate + 1
    let primes = []
    for value in range(2, number + 1):
        if is_prime[value]:
            primes = primes + [value]
    return primes

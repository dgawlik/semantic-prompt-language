---
model: gpt-6-luna
---

eval 'uses the website' {
    let result = agent(`
Get a random article from https://longform.org/random.
It will give you page with a random article link,
navigate to it and return its contents as markdown.
Save to ->[Str] @article`)

    ---
    
    judge.toolUse('webFetch', 'https://longform.org/random')
}
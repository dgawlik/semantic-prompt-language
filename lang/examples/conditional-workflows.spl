

{js}
let cond = args[0]
let i = 0
let result = null
{/js}

if cond == 'color':
    {agent model='gpt-6-luna', reasoning='low'}
    What is your favorite color? Save to -> @result
    {/agent}
else:
    {js}
    go('final')
    {/js}

while i < 2:
    {agent model='gpt-6-luna', reasoning='low'}
    Increment the number @i by one. Save to -> @i
    {/agent}

{js alias="final"}
success({result, i})
{/js}
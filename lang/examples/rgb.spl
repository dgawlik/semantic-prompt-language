//*
# Ask a person, then a model

`human()` asks in the terminal; `--human "navy blue"` answers without prompting.

    spl run examples/rgb.spl
*//

const RGB = Struct('RGB', {
    r: Int.describe('Red component'),
    g: Int.describe('Green component'),
    b: Int.describe('Blue component'),
});

const colorString = await human('What color is it?');

const color = await ask(`Convert the user's color (${colorString}) to RGB`, { schema: RGB });

success(JSON.stringify(color));


//*
# Random article word frequencies

An agent fetches a random longform article as Markdown. Plain code then counts how
often each word appears, so the counts are exact.

    spl run examples/random-article.spl
*//

---
model: gpt-6-luna
---

---
mode: agent

Get a random article from https://longform.org/random.
It will give you page with a random article link,
navigate to it and return its contents as markdown.
Save to ->[Str] @article
---

const words = article.toLowerCase().match(/\w+/g) ?? []
const freq: Record<string, number> = {}
for (const word of words) {
    freq[word] = (freq[word] ?? 0) + 1
}

success({article, length: article.length, freq})
let color = ask(len='word') 'What is the most common color of the sky on a clear day?'
let joke = ask(fmt='object') 'A joke about programmers as JSON with string fields setup and punchline'
let answer = think(reasoning='low') 'What is 17 * 23? Reply with just the number'

let greeting = None
enforce 'Reply in lowercase only' {
    forbid 'jokes' {
        greeting = ask(len='sentence') 'Greet the user named Ada'
    }
}

assert 'blue' in color.lower() 'unexpected color'
success {'color': color, 'setup': joke.setup, 'answer': answer, 'greeting': greeting}

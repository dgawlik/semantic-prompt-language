//*
# Answer support questions with custom typed tools

Defines native TypeScript tools with `defineTool`, disables the built-in file/shell tools
with `builtinTools: false`, caps turns with `maxSteps`, and returns a typed summary.

    spl run examples/custom-tools.spl --arg "ORD-1042"
*//

---
model: gpt-6-luna
---

const orderId = args[0] ?? 'ORD-1042';

const orders: Record<string, { customer: string; status: string; totalCents: number; carrier?: string }> = {
    'ORD-1042': { customer: 'Ada Lovelace', status: 'shipped', totalCents: 14900, carrier: 'DHL' },
    'ORD-1043': { customer: 'Grace Hopper', status: 'processing', totalCents: 8900 },
};

const tracking: Record<string, { location: string; etaDays: number }> = {
    'ORD-1042': { location: 'Leipzig Hub', etaDays: 2 },
};

const lookupOrder = defineTool({
    name: 'lookupOrder',
    description: 'Fetch an order record by its order ID.',
    input: Struct('LookupOrderInput', {
        id: Str.describe('Order identifier such as ORD-1042'),
    }),
    execute: ({ id }) => orders[id] ?? { error: `order ${id} not found` },
});

const getTracking = defineTool({
    name: 'getTracking',
    description: 'Look up live shipment tracking details for a shipped order.',
    input: Struct('GetTrackingInput', {
        id: Str.describe('Order identifier'),
    }),
    execute: ({ id }) => tracking[id] ?? { error: `no shipment found for ${id}` },
});

const SupportReply = Struct('SupportReply', {
    orderId: Str,
    status: Enum('processing', 'shipped', 'delivered', 'unknown'),
    etaDays: Nullable(Int),
    message: Str.describe('Short customer-facing reply'),
});

const reply = await agent(
    `Look up order ${orderId}. If it has shipped, check its tracking info too, then draft a concise status update.`,
    {
        tools: [lookupOrder, getTracking],
        builtinTools: false,
        maxSteps: 6,
        schema: SupportReply,
    },
);

success(reply);

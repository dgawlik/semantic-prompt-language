{
  "name": "splx-vscode",
  "displayName": "Semantic Prompt Language (SPL / .splx)",
  "description": "Language Server, syntax highlighting, type-aware property completion, and live JSON Schema hover for SPL (.splx)",
  "version": "0.1.0",
  "publisher": "spl-lang",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:splx",
    "onCommand:splx.restartServer"
  ],
  "main": "./extension.js",
  "scripts": {
    "install-ext": "node ../../scripts/install-vscode.mjs",
    "uninstall-ext": "node ../../scripts/install-vscode.mjs --uninstall",
    "package": "npx @vscode/vsce package"
  },
  "contributes": {
    "languages": [
      {
        "id": "splx",
        "aliases": [
          "SPL",
          "SPLX",
          "Semantic Prompt Language"
        ],
        "extensions": [
          ".splx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "splx",
        "scopeName": "source.splx",
        "path": "./syntaxes/splx.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "splx.restartServer",
        "title": "SPL: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "SPL (.splx)",
      "properties": {
        "splx.serverPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to SPL Language Server (`dist/lsp.js`). Leave empty to auto-detect from the workspace or bundled package."
        },
        "splx.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Path to Node.js 22+ executable used to run the SPL Language Server."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}

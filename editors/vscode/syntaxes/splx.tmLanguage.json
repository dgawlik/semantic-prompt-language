{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Semantic Prompt Language",
  "scopeName": "source.splx",
  "patterns": [
    { "include": "#comments" },
    { "include": "#llm-hints" },
    { "include": "#prompt-block" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#intrinsics" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.splx",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.splx",
          "match": "//.*$"
        }
      ]
    },
    "llm-hints": {
      "patterns": [
        {
          "name": "meta.annotation.llm-hint.splx",
          "match": "('')(.*)$",
          "captures": {
            "1": { "name": "punctuation.definition.llm-hint.splx" },
            "2": { "name": "markup.italic.llm-hint.splx" }
          }
        }
      ]
    },
    "prompt-block": {
      "name": "string.quoted.other.prompt.splx",
      "begin": "@\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.prompt.begin.splx" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.prompt.end.splx" }
      },
      "patterns": [
        { "include": "#interpolation" },
        { "include": "#prompt-nested-braces" },
        {
          "name": "constant.character.escape.splx",
          "match": "\\\\[$\\{\\}\\\\]"
        },
        {
          "name": "markup.inline.raw.string.splx",
          "match": "`[^`]+`"
        }
      ]
    },
    "prompt-nested-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        { "include": "#interpolation" },
        { "include": "#prompt-nested-braces" }
      ]
    },
    "interpolation": {
      "name": "meta.embedded.expression.splx",
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.splx" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.splx" }
      },
      "patterns": [
        { "include": "$self" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.splx",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "include": "#interpolation" },
        {
          "name": "constant.character.escape.splx",
          "match": "\\\\[nrt\\\\\"'$0]"
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.splx",
      "match": "'(?:\\\\.|[^'\\\\])'"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.splx",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.splx",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "intrinsics": {
      "patterns": [
        {
          "name": "support.function.intrinsic.splx",
          "match": "\\b(type_schema|decode)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.splx",
          "match": "\\b(if|else|match|while|return|for|in)\\b"
        },
        {
          "name": "keyword.other.declaration.splx",
          "match": "\\b(let|mut|fn|type|newtype|typeof|struct|enum|trait|impl|pub|import|from|as|extern|async|reified)\\b"
        },
        {
          "name": "constant.language.boolean.splx",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.language.self.splx",
          "match": "\\bself\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.splx",
          "match": "\\b(Int|Float|Str|Bool|Char|Byte|Bytes|Json|Prompt|Array|Iter|Dict|Option|Result|Unit|TypeInfo|TypeFieldInfo|TypeVariantInfo)\\b"
        },
        {
          "name": "entity.name.type.splx",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.splx",
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\(|<|\\s*@\\{)"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.splx",
          "match": "->|=>|\\.\\.\\.|\\.\\.=|\\.\\.|\\?\\.|\\?\\?|\\?|==|!=|<=|>=|&&|\\|\\||\\*\\*|<<|>>|[+\\-*/%<>=!&|^~]"
        }
      ]
    }
  }
}

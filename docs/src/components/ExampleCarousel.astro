---
import { Code } from "@astrojs/starlight/components";

interface ExampleSlide {
  id: string;
  tab: string;
  title: string;
  file: string;
  summary: string;
  docHref: string;
  docLabel: string;
  code: string;
}

const slides: ExampleSlide[] = [
  {
    id: "structured-ask",
    tab: "01 // Structured LLM",
    title: "Compile-Time Schemas with Prompt.ask<T>",
    file: "examples/agents/ask.splx",
    summary:
      "Attach '' LLM hints directly to record fields. SPL emits JSON Schema + runtime decoders at compile time.",
    docHref: "/stdlib/llm-and-agents/",
    docLabel: "std/llm docs",
    code: `import llm from "std/llm"

'' Historical figure profile returned by the model.
type Person = struct {
    firstName: Str  '' Given name, e.g. Ada
    lastName: Str   '' Family name, e.g. Lovelace
    age: Int        '' Age in years
    profession: Str '' Primary occupation
}

// Defaults to provider: "openai_responses", model: "gpt-6-luna", and ~/.spl/credentials.json (\`spl login\`).
// Automatically sends type_schema<Person>() and validates the JSON response!
let ada = @{
    Generate a profile for Ada Lovelace.
}.ask<Person>()?

print("\${ada.firstName} \${ada.lastName} (\${ada.age}) — \${ada.profession}")`,
  },
  {
    id: "tool-agent",
    tab: "02 // Tool Agent",
    title: "Streaming Tool-Calling Agent Loop",
    file: "examples/agents/agent.splx",
    summary:
      "Define strongly-typed llm.tool<In, Out> handlers, stream live text/thinking/tool deltas, and capture a replayable trace.",
    docHref: "/stdlib/llm-and-agents/",
    docLabel: "Agents & Traces",
    code: `import llm from "std/llm"
import fs from "std/fs"

type FilePath = Str            '' Path to a file
type FileContent = Str         '' Content of a file
type DirectoryPath = Str       '' Path to a directory
type DirectoryContent = Array<Str> '' Entries in a directory

let read_file = llm.tool<FilePath, FileContent>(
    name: "read_file",
    description: "Reads the content of a file given its path"
) { path ->
    Ok(fs.read(path) ?? panic("Failed to read file"))
}

let list_files = llm.tool<DirectoryPath, DirectoryContent>(
    name: "list_files",
    description: "Lists the content of a directory given its path"
) { dir ->
    Ok(fs.list_dir(dir) ?? panic("Failed to list directory"))
}

let (result, trace) = @{
    Analyze contents of ./src for known vulnerabilities.
    Summarize the findings.
}.agent(
    thinking: Some(llm.ThinkLow),
    tools: [read_file.any(), list_files.any()],
    on_delta: Some({ delta ->
        match delta {
            llm.TextDelta(text) => print_inline(text)
            llm.ToolCallDelta(name, _, _) => print_inline("[tool: " + name + "]")
            _ => ()
        }
    })
)?`,
  },
  {
    id: "row-polymorphism",
    tab: "03 // Row Types",
    title: "Open Records & Row Polymorphism",
    file: "examples/types/rows.splx",
    summary:
      "Write functions over open record shapes (`..`) that work across any matching type without inheritance boilerplate.",
    docHref: "/language/records-and-rows/",
    docLabel: "Records & Rows",
    code: `type Human = {
    height: Int
    weight: Int
}

type Fish = {
    height: Int
    weight: Int
}

type LivingThing = {
    height: Int
    weight: Int
    ..
}

fn feed(mut thing: LivingThing) {
    thing.weight = thing.weight + 1
}

let fish = Fish { height: 10, weight: 5 }
feed(fish)

let human = Human { height: 180, weight: 75 }
feed(human)

print(human) // { height: 180, weight: 76 }
print(fish)  // { height: 10, weight: 6 }`,
  },
  {
    id: "adts-matching",
    tab: "04 // ADTs & Match",
    title: "Tagged Enums, Exhaustive Match & Result",
    file: "examples/04_enums_matching_errors.splx",
    summary:
      "Zero null or undefined. Combine algebraic data types, guarded pattern matching, optional chaining, and postfix `?`.",
    docHref: "/language/enums-and-errors/",
    docLabel: "Enums & Errors",
    code: `enum AgentStep {
    Think(Str)
    ToolCall(Str, Int)
    Finish(Str)
    Abort
}

fn describe_step(step: AgentStep) -> Str {
    match step {
        Think(note) => "thinking: " + note
        ToolCall(name, n) if n > 2 => "tool '" + name + "' (high retries)"
        ToolCall(name, n) => "tool '" + name + "' (attempt " + to_str(n) + ")"
        Finish(out) => "finished: " + out
        Abort => "aborted"
    }
}

fn route_event(ev: { kind: Str, name: Str, .. }) -> Str {
    match ev {
        { kind: "call", name, ..rest } => "dispatch " + name + " " + json_stringify(rest)
        { kind: "done", name, .. } => "completed " + name
        { kind, .. } => "ignored " + kind
    }
}

print(describe_step(ToolCall("fetch", 4)))
print(route_event({ kind: "call", name: "read_file", path: "README.md" }))`,
  },
  {
    id: "dynamic-codegen",
    tab: "05 // Codegen",
    title: "Sandboxed JS, Runtime SPL & LLM Synthesis",
    file: "examples/08_dynamic_codegen.splx",
    summary:
      "Compile JS or SPL at runtime with timeout guards and schema-validated outputs — or synthesize typed functions via an LLM.",
    docHref: "/stdlib/codegen/",
    docLabel: "std/codegen docs",
    code: `import codegen from "std/codegen"

type CalcInput = struct {
    a: Int '' First integer operand
    b: Int '' Second integer operand
}

type CalcOutput = struct {
    sum: Int     '' a + b
    product: Int '' a * b
}

// 1. Sandboxed JS function with compile-time input + runtime output check
let calc_js = codegen.js_fn<CalcInput, CalcOutput>(timeout_ms: 50) @{
    return { sum: input.a + input.b, product: input.a * input.b };
}?

// 2. Runtime SPL compiler — type-checks generated SPL BEFORE running!
let calc_spl = codegen.spl_fn<CalcInput, CalcOutput> @{
    pub fn run(input) {
        { sum: input.a + input.b, product: input.a * input.b }
    }
}?

let r1 = calc_js({ a: 6, b: 7 })?
let r2 = calc_spl({ a: 10, b: 20 })?
print("js=\${r1.product}, spl=\${r2.sum}")`,
  },
  {
    id: "reified-generics",
    tab: "06 // Reified Types",
    title: "Reified Generics (`reified fn<T>`)",
    file: "examples/11_reified_types.splx",
    summary:
      "Preserve type descriptors across generic functions so `type_schema<T>()` and `decode<T>()` compose with any `T`.",
    docHref: "/language/prompts-and-reification/",
    docLabel: "Reified Types",
    code: `pub enum Priority { Low, Normal, Urgent }

pub type Task = struct {
    id: Int            '' Unique numeric task ID
    title: Str         '' Short task summary
    priority: Priority '' Task priority
    assignee: Str?     '' Optional owner handle
}

/// Preserves runtime JSON Schema + decoder for any type T!
pub reified fn validate_or_prompt<T>(raw: Str) -> Result<T, Str> {
    let parsed = json_parse(raw)?
    match decode<T>(parsed) {
        Ok(val) => Ok(val)
        Err(e) => {
            let expected = json_stringify(type_schema<T>())
            Err(e.path + ": " + e.message + " | schema: " + expected)
        }
    }
}

let task = validate_or_prompt<Task>(
    "{\\"id\\":1,\\"title\\":\\"Ship SPL\\",\\"priority\\":\\"Urgent\\"}"
)?
print("Task #\${task.id}: \${task.title} [\${to_str(task.priority)}]")`,
  },
];

const total = slides.length;
---

<section
  class="spl-carousel not-content"
  aria-roledescription="carousel"
  aria-label="SPL interactive code examples"
  data-spl-carousel
>
  <div class="spl-carousel-bar">
    <div class="spl-carousel-heading">
      <span class="spl-terminal-tag" aria-hidden="true">[EXAMPLES // {total} MODULES]</span>
      <span class="spl-carousel-counter" data-carousel-counter>01 / 0{total}</span>
    </div>

    <div class="spl-carousel-controls">
      <button
        type="button"
        class="spl-nav-btn"
        data-direction="previous"
        aria-label="Previous example"
      >
        <span aria-hidden="true">&lt;&lt;</span>
        <span>Prev</span>
      </button>
      <button
        type="button"
        class="spl-nav-btn"
        data-direction="next"
        aria-label="Next example"
      >
        <span>Next</span>
        <span aria-hidden="true">&gt;&gt;</span>
      </button>
    </div>
  </div>

  <div class="spl-carousel-track" tabindex="0" role="group" aria-label="Example slides">
    {slides.map((slide, idx) => (
      <article
        class="spl-slide"
        role="group"
        aria-roledescription="slide"
        aria-label={`${idx + 1} of ${total}: ${slide.title}`}
        data-marker-name={`Go to example ${idx + 1}: ${slide.title}`}
        data-marker-label={slide.tab}
      >
        <div class="spl-slide-meta">
          <div class="spl-slide-info">
            <h3 class="spl-slide-title">{slide.title}</h3>
            <p class="spl-slide-summary">{slide.summary}</p>
          </div>
          <div class="spl-slide-actions">
            <a class="spl-slide-link spl-slide-link-pg" href={`/playground/?example=${slide.id}`}>
              <span>Playground</span>
              <span aria-hidden="true">&gt;</span>
            </a>
            <a class="spl-slide-link" href={slide.docHref}>
              <span>{slide.docLabel}</span>
              <span aria-hidden="true">-&gt;</span>
            </a>
          </div>
        </div>
        <div class="spl-slide-code">
          <Code code={slide.code} lang="splx" title={slide.file} />
        </div>
      </article>
    ))}
  </div>

  <p class="spl-visually-hidden" role="status" aria-live="polite" data-carousel-status></p>

  <nav class="spl-carousel-markers" aria-label="Choose an example slide">
    {slides.map((slide, idx) => (
      <button
        type="button"
        class="spl-marker-btn"
        data-slide-index={idx}
        aria-label={`Go to example ${idx + 1}: ${slide.title}`}
        aria-current={idx === 0 ? "true" : undefined}
      >
        <span class="spl-marker-indicator" aria-hidden="true"></span>
        <span>{slide.tab}</span>
      </button>
    ))}
  </nav>
</section>

<script type="module">
  const carousels = document.querySelectorAll("[data-spl-carousel]");

  for (const root of carousels) {
    const track = root.querySelector(".spl-carousel-track");
    const slides = Array.from(track ? track.children : []);
    const prevBtn = root.querySelector('button[data-direction="previous"]');
    const nextBtn = root.querySelector('button[data-direction="next"]');
    const markers = Array.from(root.querySelectorAll(".spl-marker-btn"));
    const statusEl = root.querySelector("[data-carousel-status]");
    const counterEl = root.querySelector("[data-carousel-counter]");

    if (!track || slides.length === 0) continue;

    const total = slides.length;
    const canLoop = total >= 3;
    const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (canLoop && !CSS.supports("order: sibling-count()")) {
      track.style.setProperty("--children-count", String(total));
    }

    let settledIndex = 0;
    let activeMarkerIndex = 0;
    let pendingTarget = null;
    let pendingStartScrollLeft = null;
    let queuedDirection = null;
    let unparkedForMarker = false;
    let rafId = 0;
    let scrollDebounceId = 0;

    const pad2 = (n) => String(n).padStart(2, "0");

    const getScrollBehavior = () => (reducedMotionQuery.matches ? "auto" : "smooth");

    const centerOffsetOf = (slide) => {
      const trackRect = track.getBoundingClientRect();
      const slideRect = slide.getBoundingClientRect();
      return (slideRect.left + slideRect.width / 2) - (trackRect.left + trackRect.width / 2);
    };

    const nearestSlideIndex = () => {
      let bestIdx = 0;
      let bestDist = Infinity;
      for (let i = 0; i < slides.length; i++) {
        const dist = Math.abs(centerOffsetOf(slides[i]));
        if (dist < bestDist) {
          bestDist = dist;
          bestIdx = i;
        }
      }
      return bestIdx;
    };

    const visualOrderIndices = () =>
      slides
        .map((slide, idx) => ({ idx, left: slide.getBoundingClientRect().left }))
        .sort((a, b) => a.left - b.left)
        .map((entry) => entry.idx);

    const setActiveMarker = (idx) => {
      if (idx === activeMarkerIndex) return;
      activeMarkerIndex = idx;
      for (let i = 0; i < markers.length; i++) {
        if (i === idx) {
          markers[i].setAttribute("aria-current", "true");
        } else {
          markers[i].removeAttribute("aria-current");
        }
      }
      if (counterEl) {
        counterEl.textContent = `${pad2(idx + 1)} / ${pad2(total)}`;
      }
    };

    const setCurrentWithCompensation = (nextCurrent, lockOverflow) => {
      const currentVal = track.style.getPropertyValue("--current").trim();
      const desiredVal = nextCurrent === null ? "" : String(nextCurrent);
      if (currentVal === desiredVal) return;

      const anchorIdx = nearestSlideIndex();
      const anchorSlide = slides[anchorIdx];
      const beforeOffset = centerOffsetOf(anchorSlide);

      const prevSnap = track.style.scrollSnapType;
      const prevBehavior = track.style.scrollBehavior;
      track.style.scrollSnapType = "none";
      track.style.scrollBehavior = "auto";
      if (lockOverflow) {
        track.style.overflowX = "hidden";
      }

      if (nextCurrent === null) {
        track.style.setProperty("--current", "initial");
      } else {
        track.style.setProperty("--current", String(nextCurrent));
      }

      const afterOffset = centerOffsetOf(anchorSlide);
      const diff = afterOffset - beforeOffset;
      if (Math.abs(diff) > 0.5) {
        track.scrollLeft += diff;
      }

      track.style.scrollSnapType = prevSnap;
      track.style.scrollBehavior = prevBehavior;

      if (lockOverflow) {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            track.style.overflowX = "";
          });
        });
      }
    };

    const scrollToSlide = (targetIdx) => {
      const delta = centerOffsetOf(slides[targetIdx]);
      pendingTarget = targetIdx;
      pendingStartScrollLeft = track.scrollLeft;
      setActiveMarker(targetIdx);
      if (Math.abs(delta) < 1) {
        handleSettled(false);
        return;
      }
      track.scrollBy({ left: delta, behavior: getScrollBehavior() });
    };

    const navigateDirection = (direction) => {
      if (unparkedForMarker && pendingTarget !== null) {
        queuedDirection = direction;
        return;
      }
      const order = visualOrderIndices();
      const baseIdx = pendingTarget !== null ? pendingTarget : nearestSlideIndex();
      const pos = order.indexOf(baseIdx);
      if (pos === -1) return;
      const step = direction === "next" ? 1 : -1;
      const nextPos = pos + step;
      if (nextPos < 0 || nextPos >= order.length) return;
      scrollToSlide(order[nextPos]);
    };

    const updateButtonDisabledState = (idx) => {
      if (canLoop) return;
      if (prevBtn) {
        const wasFocused = document.activeElement === prevBtn;
        prevBtn.disabled = idx === 0;
        if (prevBtn.disabled && wasFocused && nextBtn) nextBtn.focus();
      }
      if (nextBtn) {
        const wasFocused = document.activeElement === nextBtn;
        nextBtn.disabled = idx === total - 1;
        if (nextBtn.disabled && wasFocused && prevBtn) prevBtn.focus();
      }
    };

    const handleSettled = (announce) => {
      // Ignore stale settle event that fires at the exact pre-scroll position before movement starts
      if (
        pendingTarget !== null &&
        pendingStartScrollLeft !== null &&
        Math.abs(track.scrollLeft - pendingStartScrollLeft) < 1 &&
        Math.abs(centerOffsetOf(slides[pendingTarget])) > 2
      ) {
        return;
      }

      const currentIdx = nearestSlideIndex();
      const changed = currentIdx !== settledIndex;
      settledIndex = currentIdx;
      pendingTarget = null;
      pendingStartScrollLeft = null;
      const wasUnparked = unparkedForMarker;
      unparkedForMarker = false;

      setActiveMarker(currentIdx);
      updateButtonDisabledState(currentIdx);

      if (canLoop) {
        const skipLock = wasUnparked && queuedDirection !== null;
        setCurrentWithCompensation(currentIdx, !skipLock);
      }

      if (announce && changed && statusEl) {
        statusEl.textContent = `Slide ${currentIdx + 1} of ${total}`;
      }

      if (queuedDirection !== null) {
        const dir = queuedDirection;
        queuedDirection = null;
        navigateDirection(dir);
      }
    };

    prevBtn?.addEventListener("click", () => navigateDirection("previous"));
    nextBtn?.addEventListener("click", () => navigateDirection("next"));

    markers.forEach((btn, idx) => {
      btn.addEventListener("click", () => {
        const currentIdx = nearestSlideIndex();
        if (idx === currentIdx && pendingTarget === null) return;
        queuedDirection = null;
        if (canLoop) {
          unparkedForMarker = true;
          // Restore DOM order without overflow lock so Safari initiates the direct trip cleanly
          setCurrentWithCompensation(null, false);
        }
        scrollToSlide(idx);
      });
    });

    const supportsScrollEnd = "onscrollend" in window;

    track.addEventListener(
      "scroll",
      () => {
        if (pendingTarget === null && !rafId) {
          rafId = requestAnimationFrame(() => {
            rafId = 0;
            setActiveMarker(nearestSlideIndex());
          });
        }
        if (!supportsScrollEnd) {
          clearTimeout(scrollDebounceId);
          scrollDebounceId = setTimeout(() => handleSettled(true), 120);
        }
      },
      { passive: true }
    );

    if (supportsScrollEnd) {
      track.addEventListener("scrollend", () => handleSettled(true));
    }

    // Initial parking & control sync (silent: do not populate status region on page load)
    if (canLoop) {
      setCurrentWithCompensation(0, false);
    }
    updateButtonDisabledState(0);
    if (counterEl) {
      counterEl.textContent = `${pad2(1)} / ${pad2(total)}`;
    }
  }
</script>

<style>
  .spl-carousel {
    margin-block: 1.5rem 2.75rem;
    border: 1px solid var(--spl-border);
    border-radius: 0.25rem;
    background: var(--spl-surface);
    overflow: hidden;
  }

  .spl-carousel-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding: 0.75rem 1rem;
    background: var(--spl-surface-raised);
    border-bottom: 1px solid var(--spl-border);
  }

  .spl-carousel-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--spl-font-display);
  }

  .spl-terminal-tag {
    color: var(--sl-color-accent-high);
    font-size: 0.9rem;
    letter-spacing: 0.06em;
  }

  .spl-carousel-counter {
    color: var(--sl-color-gray-2);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--spl-border);
    border-radius: 0.2rem;
    background: var(--spl-code-bg);
  }

  .spl-carousel-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .spl-nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-block-size: 2.25rem;
    min-inline-size: 2.25rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--spl-border);
    border-radius: 0.2rem;
    background: var(--spl-code-bg);
    color: var(--sl-color-white);
    font-family: var(--spl-font-display);
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    touch-action: manipulation;
    transition: border-color 140ms ease, background-color 140ms ease, color 140ms ease;
  }

  .spl-nav-btn:hover:not(:disabled) {
    border-color: var(--spl-border-strong);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }

  .spl-nav-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .spl-carousel-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    touch-action: manipulation;
    scrollbar-width: thin;
    scrollbar-color: var(--spl-border-strong) var(--spl-code-bg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .spl-carousel-track {
      scroll-behavior: smooth;
    }
  }

  /* Continuous looping via CSS order parking on first and last slides only */
  .spl-carousel-track > :first-child {
    order: clamp(0, var(--current) - (var(--children-count, sibling-count()) - 3), 1);
  }

  .spl-carousel-track > :last-child {
    order: calc(-1 * clamp(0, 2 - var(--current), 1));
  }

  .spl-slide {
    flex: 0 0 100%;
    min-inline-size: 0;
    scroll-snap-align: center;
    padding: 1.15rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .spl-slide-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
  }

  .spl-slide-info {
    flex: 1 1 24rem;
    min-inline-size: 0;
  }

  .spl-slide-title {
    margin: 0;
    font-family: var(--spl-font-display);
    font-size: clamp(1.15rem, 1.05rem + 0.5vw, 1.45rem);
    color: var(--sl-color-white);
    line-height: 1.25;
    text-wrap: balance;
  }

  .spl-slide-summary {
    margin: 0.35rem 0 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2);
    max-width: 72ch;
    text-wrap: pretty;
  }

  .spl-slide-actions {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .spl-slide-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-block-size: 2.1rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--spl-border-strong);
    border-radius: 0.2rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-family: var(--spl-font-display);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    white-space: nowrap;
  }

  .spl-slide-link-pg {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: #ffffff;
  }

  .spl-slide-link-pg:hover {
    background: #b91c1c;
    border-color: #b91c1c;
    color: #ffffff;
  }

  .spl-slide-link:hover {
    background: var(--sl-color-accent);
    color: #ffffff;
  }

  .spl-slide-code :global(.expressive-code) {
    margin: 0;
  }

  .spl-slide-code :global(pre) {
    max-block-size: 26rem;
    overflow: auto;
  }

  .spl-carousel-markers {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1rem;
    background: var(--spl-surface-raised);
    border-top: 1px solid var(--spl-border);
  }

  .spl-marker-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-block-size: 2.15rem;
    min-inline-size: 2.15rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--spl-border);
    border-radius: 0.2rem;
    background: var(--spl-code-bg);

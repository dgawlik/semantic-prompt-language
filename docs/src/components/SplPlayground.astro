---
import { PLAYGROUND_PRESETS } from "../playground/presets";
---

<section class="spl-playground not-content" aria-label="SPL Interactive Playground" data-spl-playground>
  <div class="spl-pg-toolbar-wrap">
    <div
      class="spl-pg-toolbar"
      role="toolbar"
      focusgroup="toolbar wrap"
      aria-label="Playground actions"
    >
      <div class="spl-pg-group" role="group" aria-label="Execution">
        <button
          type="button"
          class="spl-pg-btn spl-pg-btn-primary"
          data-pg-run
          title="Run code (Ctrl+Enter)"
        >
          <span aria-hidden="true">&gt;</span>
          <span>Run</span>
        </button>
        <button
          type="button"
          class="spl-pg-btn"
          data-pg-complete
          title="Trigger code completion (Ctrl+Space)"
        >
          <span>Complete</span>
        </button>
      </div>

      <span class="spl-pg-sep" role="separator" aria-orientation="vertical"></span>

      <div class="spl-pg-group spl-pg-preset-group" role="group" aria-label="Examples">
        <label class="spl-pg-label" for="spl-pg-preset-select">Example</label>
        <select id="spl-pg-preset-select" class="spl-pg-select" data-pg-preset>
          {PLAYGROUND_PRESETS.map((preset) => (
            <option value={preset.id}>{preset.label}</option>
          ))}
        </select>
      </div>

      <span class="spl-pg-sep" role="separator" aria-orientation="vertical"></span>

      <div class="spl-pg-group" role="group" aria-label="Share and reset">
        <button
          type="button"
          class="spl-pg-btn"
          data-pg-share
          title="Copy shareable URL"
        >
          <span>Share Link</span>
        </button>
        <button
          type="button"
          class="spl-pg-btn"
          data-pg-reset
          title="Reset to selected example"
        >
          <span>Reset</span>
        </button>
      </div>
    </div>

    <p class="spl-pg-hint">
      <kbd>Ctrl</kbd>+<kbd>Space</kbd> code completion &middot; <kbd>Ctrl</kbd>+<kbd>Enter</kbd> run &middot; hover symbols for inferred types
    </p>
  </div>

  <p class="spl-visually-hidden" role="status" aria-live="polite" data-pg-live-status></p>

  <div class="spl-pg-workspace">
    <!-- Left pane: Editor in IDE frame -->
    <div class="spl-pg-frame spl-pg-editor-pane">
      <div class="spl-pg-frame-header">
        <span class="spl-pg-dots" aria-hidden="true">
          <span class="spl-pg-dot"></span>
          <span class="spl-pg-dot"></span>
          <span class="spl-pg-dot"></span>
        </span>
        <span class="spl-pg-tab-active">
          <span class="spl-pg-tab-pip" aria-hidden="true"></span>
          <span data-pg-filename>rows.splx</span>
        </span>
        <span class="spl-pg-lang-pill" aria-hidden="true">SPLX // LSP</span>
      </div>

      <div class="spl-pg-signature" data-pg-signature hidden></div>
      <div class="spl-pg-editor-mount" data-pg-editor></div>

      <div class="spl-pg-statusbar" aria-hidden="true">
        <div class="spl-pg-status-group">
          <span class="spl-pg-status-mode">SPLX</span>
          <span class="spl-pg-status-item" data-pg-diag-summary>0 problems</span>
        </div>
        <div class="spl-pg-status-group">
          <span class="spl-pg-status-item" data-pg-cursor>Ln 1, Col 1</span>
          <span class="spl-pg-status-item">Spaces: 4</span>
          <span class="spl-pg-status-item">UTF-8</span>
        </div>
      </div>
    </div>

    <!-- Right pane: Output / Compiled JS / Problems / Schemas -->
    <div class="spl-pg-frame spl-pg-output-pane">
      <div class="spl-pg-frame-header spl-pg-tabs-header">
        <div
          class="spl-pg-tablist"
          focusgroup="tablist nomemory"
          aria-label="Playground output views"
          data-pg-tablist
        >
          <button
            type="button"
            id="pg-tab-output"
            class="spl-pg-tab"
            aria-selected="true"
            focusgroupstart
          >
            Output
          </button>
          <button
            type="button"
            id="pg-tab-js"
            class="spl-pg-tab"
            aria-selected="false"
          >
            Compiled JS
          </button>
          <button
            type="button"
            id="pg-tab-problems"
            class="spl-pg-tab"
            aria-selected="false"
          >
            <span>Problems</span>
            <span class="spl-pg-count" data-pg-problems-count>0</span>
          </button>
          <button
            type="button"
            id="pg-tab-schemas"
            class="spl-pg-tab"
            aria-selected="false"
          >
            <span>Schemas</span>
            <span class="spl-pg-count" data-pg-schemas-count>0</span>
          </button>
        </div>
        <span class="spl-pg-run-meta" data-pg-run-meta>Ready</span>
      </div>

      <div class="spl-pg-panels">
        <div role="tabpanel" aria-labelledby="pg-tab-output" tabindex="0">
          <div class="spl-panel-body" data-pg-output></div>
        </div>
        <div role="tabpanel" aria-labelledby="pg-tab-js" hidden="until-found">
          <div class="spl-panel-body">
            <pre class="spl-code-output" data-pg-js></pre>
          </div>
        </div>
        <div role="tabpanel" aria-labelledby="pg-tab-problems" hidden="until-found">
          <div class="spl-panel-body" data-pg-problems></div>
        </div>
        <div role="tabpanel" aria-labelledby="pg-tab-schemas" hidden="until-found">
          <div class="spl-panel-body" data-pg-schemas></div>
        </div>
      </div>

      <div class="spl-pg-statusbar" aria-hidden="true">
        <div class="spl-pg-status-group">
          <span class="spl-pg-status-mode">BROWSER ESM</span>
          <span class="spl-pg-status-item">12 std/* modules loaded</span>
        </div>
        <div class="spl-pg-status-group">
          <span class="spl-pg-status-item">Browser ESM + /api/llm proxy</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import "../playground/mount-playground";
</script>

<style>
  .spl-playground {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-block: 0.5rem 2rem;
  }

  .spl-pg-toolbar-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--spl-border);
    border-radius: 0.3rem;
    background: var(--spl-surface);
  }

  .spl-pg-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .spl-pg-group {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .spl-pg-sep {
    display: inline-block;
    inline-size: 0;
    block-size: 1.4rem;
    border-inline-start: 1px solid var(--spl-border);
  }

  .spl-pg-label {
    font-family: var(--spl-font-display);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .spl-pg-select {
    min-block-size: 2.2rem;
    padding-block: 0.3rem;
    padding-inline: 0.65rem 1.75rem;
    border: 1px solid var(--spl-border);
    border-radius: 0.22rem;
    background: var(--spl-code-bg);
    color: var(--sl-color-white);
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    cursor: pointer;
  }

  .spl-pg-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-block-size: 2.2rem;
    min-inline-size: 2.2rem;
    padding-block: 0.32rem;
    padding-inline: 0.78rem;
    border: 1px solid var(--spl-border);
    border-radius: 0.22rem;
    background: var(--spl-code-bg);
    color: var(--sl-color-white);
    font-family: var(--spl-font-display);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    touch-action: manipulation;
  }

  @media (prefers-reduced-motion: no-preference) {
    .spl-pg-btn {
      transition: border-color 140ms ease, background-color 140ms ease, color 140ms ease;
    }
  }

  @media (hover: hover) {
    .spl-pg-btn:hover:not([aria-disabled="true"]) {
      border-color: var(--spl-border-strong);
      color: var(--sl-color-accent-high);
    }

    .spl-pg-btn-primary:hover:not([aria-disabled="true"]) {
      background: #b91c1c;
      border-color: #b91c1c;
      color: #ffffff;
    }
  }

  .spl-pg-btn-primary {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: #ffffff;
  }

  .spl-pg-btn[aria-disabled="true"] {
    opacity: 0.55;
    cursor: wait;
  }

  @media (pointer: coarse) {
    .spl-pg-btn,
    .spl-pg-select {
      min-block-size: 2.75rem;
    }
  }

  .spl-pg-hint {
    margin: 0;
    font-size: 0.76rem;
    color: var(--sl-color-gray-3);
  }

  .spl-pg-hint kbd {
    display: inline-block;
    padding: 0.08rem 0.35rem;
    border: 1px solid var(--spl-border);
    border-radius: 0.18rem;
    background: var(--spl-code-bg);
    color: var(--sl-color-gray-1);
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
  }

  /* ---- Split IDE Workspace ---- */
  .spl-pg-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: stretch;
  }

  @media (max-width: 62rem) {
    .spl-pg-workspace {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .spl-pg-frame {
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
    min-block-size: 34rem;
    max-block-size: 46rem;
    border: 1px solid var(--spl-code-border);
    border-radius: 0.35rem;
    background: var(--spl-code-bg);
    box-shadow: var(--spl-editor-shadow);
    overflow: hidden;
  }

  .spl-pg-frame-header {
    display: flex;
    align-items: stretch;
    gap: 0.65rem;
    min-block-size: 2.45rem;
    padding-inline: 0.85rem 0.75rem;
    background: var(--spl-code-chrome);
    border-bottom: 1px solid var(--spl-code-border);
  }

  .spl-pg-dots {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    flex-shrink: 0;
  }

  .spl-pg-dot {
    display: inline-block;
    inline-size: 0.58rem;
    block-size: 0.58rem;
    border-radius: 50%;
    border: 1px solid transparent;
  }

  .spl-pg-dot:nth-child(1) {
    background: var(--spl-dot-red);
    border-color: var(--spl-dot-red);
  }
  .spl-pg-dot:nth-child(2) {
    background: var(--spl-dot-amber);
    border-color: var(--spl-dot-amber);
  }
  .spl-pg-dot:nth-child(3) {
    background: var(--spl-dot-muted);
    border-color: var(--spl-dot-muted);
  }

  .spl-pg-tab-active {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-block-start: 0.25rem;
    margin-block-end: -1px;
    padding-block: 0.32rem;
    padding-inline: 0.85rem 1rem;
    background: var(--spl-code-bg);
    color: var(--sl-color-white);
    border: 1px solid var(--spl-code-border);
    border-bottom: 1px solid var(--spl-code-bg);
    border-radius: 0.22rem 0.22rem 0 0;
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .spl-pg-tab-active::after {
    content: "";
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 2px;
    background: var(--sl-color-accent);
  }

  .spl-pg-tab-pip {
    display: inline-block;
    inline-size: 0.42rem;
    block-size: 0.42rem;
    border-radius: 1px;
    background: var(--sl-color-accent);
  }

  .spl-pg-lang-pill {
    margin-inline-start: auto;
    align-self: center;
    padding-block: 0.14rem;
    padding-inline: 0.5rem;
    border: 1px solid var(--spl-code-border);
    border-radius: 0.18rem;
    background: var(--spl-code-bg);
    color: var(--sl-color-accent-high);
    font-family: var(--spl-font-display);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .spl-pg-signature {
    padding-block: 0.32rem;
    padding-inline: 0.85rem;
    background: var(--spl-code-status-bg);
    border-bottom: 1px solid var(--spl-code-border);
    color: var(--sl-color-gray-1);
    font-family: var(--sl-font-mono);
    font-size: 0.76rem;
    white-space: nowrap;
    overflow-x: auto;
  }

  .spl-pg-editor-mount {
    flex: 1 1 auto;
    min-block-size: 0;
    overflow: hidden;
  }

  /* ---- Output Tabs (single row, scrolling, aria-selected border underline) ---- */
  .spl-pg-tabs-header {
    padding-inline: 0.35rem 0.75rem;
    gap: 0.5rem;
  }

  .spl-pg-tablist {
    display: flex;
    align-items: stretch;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: inline proximity;
    min-inline-size: 0;
    flex: 1 1 auto;
  }

  .spl-pg-tablist::-webkit-scrollbar {
    display: none;
  }

  .spl-pg-tab {
    position: relative;
    flex: none;
    scroll-snap-align: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-block: 0.45rem;
    padding-inline: 0.75rem;
    border: none;
    background: transparent;
    color: var(--sl-color-gray-3);
    font-family: var(--spl-font-display);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
  }

  .spl-pg-tab[aria-selected="true"] {
    color: var(--sl-color-white);
  }

  .spl-pg-tab[aria-selected="true"]::after {
    content: "";
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0.35rem;
    border-block-end: 3px solid var(--sl-color-accent);
  }

  .spl-pg-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 1.25rem;
    padding-inline: 0.3rem;
    border: 1px solid var(--spl-border);
    border-radius: 0.18rem;
    background: var(--spl-code-bg);
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }

  .spl-pg-count[data-has-errors="true"] {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
  }

  .spl-pg-run-meta {
    align-self: center;
    flex-shrink: 0;
    padding-block: 0.14rem;
    padding-inline: 0.48rem;
    border: 1px solid var(--spl-code-border);
    border-radius: 0.18rem;
    background: var(--spl-code-bg);
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
  }

  .spl-pg-run-meta[data-state="error"] {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
  }

  /* Panels share a single grid cell; styling lives on inner .spl-panel-body for hidden="until-found" safety */
  .spl-pg-panels {
    flex: 1 1 auto;
    min-block-size: 0;
    display: grid;
    overflow: hidden;
  }

  .spl-pg-panels > [role="tabpanel"] {
    grid-area: 1 / 1;
    min-block-size: 0;
    min-inline-size: 0;
    overflow: auto;
  }

  .spl-panel-body {
    padding: 0.9rem 1rem;
    font-family: var(--sl-font-mono);
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--sl-color-gray-1);
  }

  .spl-code-output {
    margin: 0;
    white-space: pre;
    overflow-x: auto;
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--sl-color-gray-1);
  }

  .spl-pg-panels :global(.spl-out-line) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .spl-pg-panels :global(.spl-out-warn) {
    color: #d97706;
  }

  .spl-pg-panels :global(.spl-out-error) {
    color: var(--sl-color-accent-high);
    padding-inline-start: 0.6rem;
    border-inline-start: 2px solid var(--sl-color-accent);
    margin-block: 0.25rem;
  }

  .spl-pg-panels :global(.spl-empty-state) {
    margin: 0;
    color: var(--sl-color-gray-3);
    font-style: italic;
  }

  .spl-pg-panels :global(.spl-problems-list) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .spl-pg-panels :global(.spl-problem-item) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.65rem;
    inline-size: 100%;
    text-align: start;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--spl-border);
    border-inline-start: 3px solid var(--sl-color-accent);
    border-radius: 0.2rem;
    background: var(--spl-surface);
    color: var(--sl-color-gray-1);
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    cursor: pointer;
  }

  .spl-pg-panels :global(.spl-problem-loc) {
    color: var(--sl-color-accent-high);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .spl-pg-panels :global(.spl-problem-src) {
    color: var(--sl-color-gray-3);
    font-size: 0.72rem;
  }

  .spl-pg-panels :global(.spl-problem-msg) {
    flex-basis: 100%;
    color: var(--sl-color-white);
  }

  .spl-pg-panels :global(.spl-schema-card) {
    border: 1px solid var(--spl-border);
    border-radius: 0.22rem;
    margin-block-end: 0.85rem;
    overflow: hidden;
  }

  .spl-pg-panels :global(.spl-schema-head) {
    padding: 0.35rem 0.65rem;
    background: var(--spl-code-chrome);
    border-bottom: 1px solid var(--spl-border);
    color: var(--sl-color-accent-high);
    font-size: 0.74rem;
    font-weight: 600;
  }

  .spl-pg-panels :global(.spl-schema-card pre) {
    padding: 0.7rem;
  }

  /* ---- Bottom IDE status bar ---- */
  .spl-pg-statusbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem 0.85rem;
    min-block-size: 1.7rem;
    padding-block: 0.22rem;
    padding-inline: 0.75rem;
    background: var(--spl-code-status-bg);
    color: var(--spl-code-status-fg);
    border-top: 1px solid var(--spl-code-border);
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }

  .spl-pg-status-group {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
  }

  .spl-pg-status-mode {
    padding-block: 0.05rem;
    padding-inline: 0.42rem;
    border: 1px solid var(--spl-border);
    border-radius: 0.15rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-family: var(--spl-font-display);
    letter-spacing: 0.06em;
  }

  .spl-pg-status-item:not(:first-child)::before {
    content: "|";
    content: "|" / "";
    margin-inline-end: 0.55rem;
    opacity: 0.45;
  }

  .spl-pg-status-item[data-has-errors="true"] {
    color: var(--sl-color-accent-high);
    font-weight: 600;
  }

  /* ---- CodeMirror autocomplete kind badge & hover tooltip ---- */
  :global(.spl-cm-kind) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 2.1rem;
    padding: 0.05rem 0.3rem;
    border: 1px solid var(--spl-border);
    border-radius: 0.16rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-family: var(--spl-font-display);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  :global(.spl-hover-tooltip) {
    padding: 0.55rem 0.75rem;
    max-inline-size: 28rem;
    max-block-size: 16rem;
    overflow: auto;
    white-space: pre-wrap;
    line-height: 1.5;
  }

  .spl-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (forced-colors: active) {
    .spl-pg-frame {
      box-shadow: none;
      border-color: CanvasText;
    }

    .spl-pg-btn,
    .spl-pg-select,
    .spl-pg-count,
    .spl-pg-run-meta {
      border: 1px solid ButtonBorder;
    }

    .spl-pg-tab[aria-selected="true"]::after {
      border-block-end-color: Highlight;
    }

    .spl-pg-dot {
      background: Canvas;
      border-color: CanvasText;
    }
  }
</style>

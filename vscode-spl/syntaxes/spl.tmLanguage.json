{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SPL v5",
  "scopeName": "source.spl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#template-strings" },
    { "include": "#declarations" },
    { "include": "#effects" },
    { "include": "#builtins" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#function-calls" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.spl",
          "match": "//.*$"
        },
        {
          "name": "comment.block.spl",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.spl",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.spl",
          "match": "\\\\([\"\\\\nrt]|u\\{[0-9a-fA-F]{1,6}\\})"
        },
        {
          "name": "invalid.illegal.escape.spl",
          "match": "\\\\."
        }
      ]
    },
    "template-strings": {
      "name": "string.template.spl",
      "begin": "`",
      "end": "`",
      "patterns": [
        {
          "name": "constant.character.escape.spl",
          "match": "\\\\([`\\\\$nrt]|u\\{[0-9a-fA-F]{1,6}\\})"
        },
        {
          "name": "meta.template.expression.spl",
          "begin": "\\$\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.template-expression.begin.spl" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.template-expression.end.spl" }
          },
          "contentName": "meta.embedded.line.spl",
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.spl" },
            "2": { "name": "entity.name.function.spl" }
          }
        },
        {
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.type.spl" },
            "2": { "name": "entity.name.type.spl" }
          }
        },
        {
          "match": "\\b(input|state)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.spl" },
            "2": { "name": "variable.other.readwrite.spl" }
          }
        },
        {
          "match": "\\b(let)\\s+(mut\\s+)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.spl" },
            "2": { "name": "storage.modifier.mut.spl" },
            "3": { "name": "variable.other.local.spl" }
          }
        }
      ]
    },
    "effects": {
      "patterns": [
        {
          "match": "\\b(model)\\.(ask|decide)\\b",
          "captures": {
            "1": { "name": "support.class.effect.model.spl" },
            "2": { "name": "support.function.effect.model.spl" }
          }
        },
        {
          "match": "\\b(web)\\.(search|fetch)\\b",
          "captures": {
            "1": { "name": "support.class.effect.web.spl" },
            "2": { "name": "support.function.effect.web.spl" }
          }
        },
        {
          "match": "\\b(fs)\\.(read|write|append|exists|list|stat)\\b",
          "captures": {
            "1": { "name": "support.class.effect.fs.spl" },
            "2": { "name": "support.function.effect.fs.spl" }
          }
        },
        {
          "match": "\\b(shell)\\.(run)\\b",
          "captures": {
            "1": { "name": "support.class.effect.shell.spl" },
            "2": { "name": "support.function.effect.shell.spl" }
          }
        },
        {
          "match": "\\b(tool)\\.([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "support.class.effect.tool.spl" },
            "2": { "name": "support.function.effect.tool.spl" }
          }
        },
        {
          "match": "\\b(mcp)\\.([A-Za-z_][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "support.class.effect.mcp.spl" },
            "2": { "name": "entity.name.namespace.mcp.spl" },
            "3": { "name": "support.function.effect.mcp.spl" }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "match": "\\b(str|list|map|math|json)\\.([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "support.class.builtin.spl" },
            "2": { "name": "support.function.builtin.spl" }
          }
        },
        {
          "name": "support.function.builtin.spl",
          "match": "\\b(len)(?=\\s*\\()"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.spl",
          "match": "\\b(if|else|switch|case|default|while|for|in|break|continue|return|try|catch)\\b"
        },
        {
          "name": "keyword.operator.cast.spl",
          "match": "\\b(as)\\b"
        },
        {
          "name": "storage.modifier.spl",
          "match": "\\b(let|mut|fn|type|input|state)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.spl",
          "match": "\\b(bool|int|float|string|json|void|Error|list|map)\\b"
        },
        {
          "name": "entity.name.type.spl",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "name": "constant.language.spl",
      "match": "\\b(true|false|null)\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.spl",
          "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.float.spl",
          "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)([eE][+-]?[0-9]+)?\\b|\\b[0-9][0-9_]*[eE][+-]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.spl",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "function-calls": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.spl" }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.nullability.spl",
          "match": "\\?\\?|\\?\\.\\[|\\?\\.|\\?"
        },
        {
          "name": "keyword.operator.arrow.spl",
          "match": "->"
        },
        {
          "name": "keyword.operator.logical.spl",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.comparison.spl",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.bitwise.spl",
          "match": ">>>|<<|>>|&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.arithmetic.spl",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment.spl",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.spl",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.spl",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.spl",
          "match": ":"
        }
      ]
    }
  }
}
